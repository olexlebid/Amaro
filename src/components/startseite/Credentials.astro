---
// Trust/credentials section. Figma node 563:3948.
const credentials = [
  {
    emoji: "🕺",
    title: "20+ Jahre Erfahrung",
    text: "Martin Priebe unterrichtet seit über 20 Jahren nach ADTV-Standard und bildet als Ausbildungsleiter selbst neue Trainer aus.",
  },
  {
    emoji: "🏆",
    title: "18× Deutscher Meister",
    text: "Unsere Hip-Hop-Teams unter Choreograf Samier Khan holten beim Bundesfinale „Tanzen in der Schule“ in Frankfurt den 1. und 4. Platz.",
  },
  {
    emoji: "🥉",
    title: "2× Bronze-Europameister",
    text: "Ekatarina Draganova, Europameisterin in Standard und Latein, unterrichtet bei uns Paare und ambitionierte Turniertänzer.",
  },
  {
    emoji: "🌎",
    title: "International Weiterbildungen",
    text: "Diesen Sommer war unser Team bei Masterclasses im legendären 1MILLION Dance Studio in Seoul – für Unterricht auf höchstem Niveau.",
  },
];
---

<section class="credentials section">
  <div class="container">
    <div class="credentials__intro">
      <p class="credentials__eyebrow u-upper-200">Das ist Amaro</p>
      <p class="credentials__heading">
        Bei uns tauscht dein Kind Bildschirmzeit gegen Bühnenzeit — mit ganz viel Spaß,<br />
        ein bisschen Ehrgeiz und Trainern, die selbst schon<br />
        auf internationalen Parketts standen
      </p>
    </div>

    <hr class="credentials__divider" />

    <ul class="credentials__grid">
      {credentials.map((item) => (
        <li class="credentials__item">
          <span class="credentials__emoji" aria-hidden="true">{item.emoji}</span>
          <p class="credentials__item-title">{item.title}</p>
          <p class="credentials__item-text">{item.text}</p>
        </li>
      ))}
    </ul>

    <hr class="credentials__divider" />
  </div>
</section>

<style>
  .credentials__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    text-align: center;
    max-width: 978px;
    margin: 0 auto var(--space-16);
  }

  .credentials__eyebrow {
    color: var(--color-grey-500);
  }

  .credentials__heading {
    font-family: var(--font-family-base);
    font-weight: var(--font-title-weight);
    font-size: var(--font-title-400-size);
    line-height: var(--font-title-400-line);
    color: var(--color-grey-900);
  }

  .credentials__divider {
    border: none;
    border-top: 1px solid #d3d2ce;
    margin: 0 0 var(--space-10);
  }

  .credentials__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-16);
    list-style: none;
    margin: 0 0 var(--space-10);
    padding: 0;
  }

  .credentials__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .credentials__emoji {
    font-size: 2rem;
    line-height: 1;
  }

  .credentials__item-title {
    font-family: var(--font-family-base);
    font-weight: var(--font-title-weight);
    font-size: var(--font-title-200-size);
    line-height: var(--font-title-200-line);
    color: var(--color-grey-900);
  }

  .credentials__item-text {
    font-family: var(--font-family-base);
    font-weight: var(--font-body-weight);
    font-size: var(--font-body-200-size);
    line-height: var(--font-body-200-line);
    color: var(--color-grey-600);
  }

  @media (max-width: 900px) {
    .credentials__heading {
      font-size: 1.75rem;
    }

    .credentials__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
