---
// Trust/credentials section. Figma node 563:3948.
import { Image } from "astro:assets";
import phoneImg from "../../assets/startseite/about_floating_img_1.jpg";
import trophyImg from "../../assets/startseite/about_floating_img_2.jpg";

const credentials = [
  {
    emoji: "🕺",
    title: "20+ Jahre Erfahrung",
    text: "Martin Priebe unterrichtet seit über 20 Jahren nach ADTV-Standard und bildet als Ausbildungsleiter selbst neue Trainer aus.",
  },
  {
    emoji: "🏆",
    title: "18× Deutscher Meister",
    text: "Unsere Hip-Hop-Teams unter Choreograf Samier Khan holten beim Bundesfinale „Tanzen in der Schule“ in Frankfurt den 1. und 4. Platz.",
  },
  {
    emoji: "🥉",
    title: "2× Bronze-Europameister",
    text: "Ekatarina Draganova, Europameisterin in Standard und Latein, unterrichtet bei uns Paare und ambitionierte Turniertänzer.",
  },
  {
    emoji: "🌎",
    title: "International Weiterbildungen",
    text: "Diesen Sommer war unser Team bei Masterclasses im legendären 1MILLION Dance Studio in Seoul – für Unterricht auf höchstem Niveau.",
  },
];
---

<section class="credentials section">
  <div class="container">
    <div class="credentials__intro" data-reveal-images>
      <p class="credentials__eyebrow u-upper-200">Das ist Amaro</p>
      <p class="credentials__heading">
        Bei uns tauscht dein Kind <Image class="credentials__inline-img" src={phoneImg} alt="" aria-hidden="true" data-reveal-img="1" width={176} height={80} /> Bildschirmzeit <span class="credentials__nowrap">gegen Bühnenzeit</span><span class="credentials__heading-dash"> — </span><span class="credentials__heading-desc">mit ganz viel Spaß,<br class="credentials__break" />{" "}ein bisschen Ehrgeiz und Trainern, die selbst schon<br class="credentials__break" />{" "}auf <Image class="credentials__inline-img" src={trophyImg} alt="" aria-hidden="true" data-reveal-img="2" width={176} height={80} /> internationalen Parketts standen</span>
      </p>
    </div>

    <hr class="credentials__divider" />

    <ul class="credentials__grid">
      {credentials.map((item) => (
        <li class="credentials__item">
          <span class="credentials__emoji" aria-hidden="true">{item.emoji}</span>
          <p class="credentials__item-title">{item.title}</p>
          <p class="credentials__item-text">{item.text}</p>
        </li>
      ))}
    </ul>

    <hr class="credentials__divider" />
  </div>
</section>

<style>
  .credentials {
    /* Directly follows Hero, a dark full-bleed section with no padding of
       its own to contribute — so this section carries the whole gap alone
       (152px) instead of splitting it 76/76 with a neighbour. */
    padding-top: clamp(4rem, 16vh, var(--space-38));
  }

  .credentials__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    text-align: center;
    max-width: 978px;
    margin: 0 auto var(--space-16);
  }

  .credentials__eyebrow {
    color: var(--color-grey-500);
  }

  .credentials__heading {
    font-family: var(--font-family-base);
    font-weight: var(--font-title-weight);
    font-size: var(--font-title-400-size);
    line-height: var(--font-title-400-line);
    color: var(--color-grey-900);
  }

  .credentials__nowrap {
    white-space: nowrap;
  }

  .credentials__inline-img {
    display: inline-block;
    width: clamp(64px, 7vw, 96px);
    height: auto;
    aspect-ratio: 176 / 80;
    object-fit: cover;
    border-radius: 20px;
    vertical-align: middle;
    margin: 0 var(--space-1) 0.15em;
  }

  /* JS-enhanced pending/reveal state — see script below. Without JS (or with
     prefers-reduced-motion) the images just stay in their plain, fully
     visible resting state from the rule above. Growing the width from 0 (not
     a plain opacity fade) is the point: the surrounding text reflows and
     parts around the image as it expands to full size. */
  .credentials__inline-img--anim {
    width: 0;
    transition: width 1s ease;
  }

  .credentials__intro.is-visible .credentials__inline-img[data-reveal-img="1"] {
    width: clamp(64px, 7vw, 96px);
  }

  .credentials__intro.is-visible .credentials__inline-img[data-reveal-img="2"] {
    width: clamp(64px, 7vw, 96px);
    transition-delay: 0.25s;
  }

  .credentials__divider {
    border: none;
    border-top: 1px solid #d3d2ce;
    margin: 0 0 var(--space-10);
  }

  .credentials__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-16);
    list-style: none;
    margin: 0 0 var(--space-10);
    padding: 0;
  }

  .credentials__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .credentials__emoji {
    font-size: 2rem;
    line-height: 1;
  }

  .credentials__item-title {
    font-family: var(--font-family-base);
    font-weight: var(--font-title-weight);
    font-size: var(--font-title-200-size);
    line-height: var(--font-title-200-line);
    color: var(--color-grey-900);
  }

  .credentials__item-text {
    font-family: var(--font-family-base);
    font-weight: var(--font-body-weight);
    font-size: var(--font-body-200-size);
    line-height: var(--font-body-200-line);
    color: var(--color-grey-600);
  }

  /* Mobile layout — Figma node 601:1116. Distinct enough from desktop (text
     split into a bold headline + a separate lighter paragraph, one photo
     instead of two, icon-beside-title credential rows) that it's easiest to
     read as its own block rather than interleaved value-by-value above. */
  @media (max-width: 900px) {
    /* This section carries the whole 80px gap to Programs alone (see the
       matching padding-top override there) instead of splitting the
       default 76/76 section rhythm — Figma's mobile frame wants 80px total. */
    .credentials {
      padding-bottom: 0;
    }

    /* The base rule's 40px margin-bottom would otherwise leak past this
       section's now-zero padding-bottom and stack on top of Programs' own
       80px, so it's zeroed here specifically for the trailing divider. */
    .credentials__divider:last-of-type {
      margin-bottom: 0;
    }

    .credentials__intro {
      align-items: flex-start;
      text-align: left;
    }

    .credentials__eyebrow {
      font-size: var(--font-upper-100-size);
    }

    .credentials__heading {
      font-size: 2rem; /* 32px */
    }

    /* The " — " joining the two halves and the desktop-only manual line
       breaks both disappear on mobile: .credentials__heading-desc below
       becomes its own block, so it starts a fresh line on its own. */
    .credentials__heading-dash,
    .credentials__break {
      display: none;
    }

    .credentials__heading-desc {
      display: block;
      margin-top: var(--space-4);
      font-family: var(--font-family-base);
      font-weight: var(--font-body-weight);
      font-size: var(--font-body-200-size);
      line-height: var(--font-body-200-line);
      color: var(--color-grey-600);
    }

    /* Mobile frame only shows the first (phone) photo. */
    .credentials__inline-img[data-reveal-img="2"] {
      display: none;
    }

    /* Divider-to-first-item gap is 40px on mobile too, same as desktop. */
    .credentials__divider:first-of-type {
      margin-bottom: var(--space-10);
    }

    .credentials__grid {
      grid-template-columns: 1fr;
      gap: var(--space-10); /* 40px */
    }

    /* Icon beside the title, description indented to align under the title
       (not the icon) — a 2-column grid instead of desktop's stacked column. */
    .credentials__item {
      display: grid;
      grid-template-columns: 32px 1fr;
      column-gap: var(--space-4);
      row-gap: var(--space-4);
    }

    .credentials__emoji {
      grid-column: 1;
      grid-row: 1;
    }

    .credentials__item-title {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      /* Figma mobile frame (601:1116) specs this row's title at 20px/115%
         line-height — smaller than --font-title-200-size (28px, the desktop
         value) and not on the shared title scale, so set directly. */
      font-size: 1.25rem; /* 20px */
      line-height: 1.15;
    }

    .credentials__item-text {
      grid-column: 2;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .credentials__inline-img--anim {
      width: clamp(64px, 7vw, 96px);
      transition: none;
    }
  }
</style>

<script>
  // Grows the two inline photos in the credentials heading from 0 to full
  // width once the section scrolls into view — first image, then the second
  // 0.25s later (handled by the CSS transition-delay above), so the text
  // visibly parts around each as it expands. Re-runs on every page load
  // (this is a plain scroll-into-view reveal, not tied to the preloader's
  // once-per-session flag — see Preloader.astro). Progressive enhancement:
  // without JS (or with prefers-reduced-motion) the images keep their plain,
  // fully visible resting state — see the CSS.
  const container = document.querySelector<HTMLElement>("[data-reveal-images]");
  const images = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal-img]"));
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (container && images.length && !reducedMotion) {
    images.forEach((img) => img.classList.add("credentials__inline-img--anim"));

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            container.classList.add("is-visible");
            observer.disconnect();
          }
        });
      },
      { threshold: 0.4 },
    );
    observer.observe(container);
  }
</script>
