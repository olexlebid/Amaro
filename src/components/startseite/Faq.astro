---
// FAQ section — static Q&A list (no accordion in the Figma design). Node 563:3977.
import Button from "../Button.astro";

const faqs = [
  {
    question: "Was soll ich zur ersten Probestunde anziehen?",
    answer: "Bequeme Kleidung und Sportschuhe reichen völlig. Für Kinder empfehlen wir Turnschuhe ohne dunkle Sohle, die den Boden markieren.",
  },
  {
    question: "Dürfen Eltern beim Unterricht zuschauen?",
    answer: "Ja, bei der ersten Probestunde sind Eltern jederzeit willkommen. Danach lassen wir den Kindern gern ihren eigenen Raum.",
  },
  {
    question: "Brauche ich für den Paartanzkurs einen festen Partner?",
    answer: "Nein, wir gleichen unsere Gruppen aktiv aus. Auch alleine kann man bei uns einsteigen.",
  },
  {
    question: "Wie läuft die Anmeldung ab?",
    answer: "Über unser Buchungssystem wählst du Kurs, Alter und einen freien Termin und meldest dich in wenigen Minuten online an. Kein Anruf nötig.",
  },
  {
    question: "Sind die Kurse mit dem Bildungspaket (BuT) kombinierbar?",
    answer: "Ja, unsere Kinder- und Jugendkurse sind mit BuT kombinierbar. Sprich uns bei der Anmeldung einfach darauf an.",
  },
];
---

<section class="faq section" id="faq">
  <div class="container faq__grid">
    <div class="faq__intro">
      <p class="faq__eyebrow u-upper-200">FAQs</p>
      <h2 class="faq__heading">Häufige Fragen</h2>
      <Button class="faq__cta faq__cta--top" variant="primary" icon="right" href="#">Weitere Fragen</Button>
    </div>

    <dl class="faq__list">
      {faqs.map((item) => (
        <div class="faq__item">
          <dt class="faq__question">{item.question}</dt>
          <dd class="faq__answer">{item.answer}</dd>
        </div>
      ))}
    </dl>

    <Button class="faq__cta faq__cta--bottom" variant="primary" icon="right" href="#">Weitere Fragen</Button>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-16);
  }

  .faq__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .faq__eyebrow {
    color: var(--color-grey-500);
  }

  .faq__heading {
    font-family: var(--font-family-base);
    font-weight: var(--font-title-weight);
    font-size: clamp(2.5rem, 6vw, var(--font-title-600-size));
    line-height: var(--font-title-600-line);
    color: var(--color-grey-900);
    /* Figma (node 563:3980) wraps "Häufige Fragen" onto two lines via a
       fixed 468px box at the 80px desktop type size — max-width (not a
       fixed width) keeps that same break on the smaller clamped sizes
       between breakpoints instead of just cutting the box down proportionally. */
    max-width: 468px;
  }

  .faq__list {
    margin: 0;
    /* Drops the first question down to line up with the heading's own top
       (not the eyebrow above it) — the grid otherwise top-aligns both
       columns flush with .faq__intro's first child, the eyebrow. */
    margin-top: calc(var(--font-upper-200-size) + var(--space-6));
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .faq__question {
    font-family: var(--font-family-base);
    font-weight: var(--font-title-weight);
    font-size: var(--font-title-100-size);
    line-height: var(--font-title-100-line);
    color: var(--color-grey-900);
    margin-bottom: var(--space-3);
  }

  .faq__answer {
    margin: 0;
    font-family: var(--font-family-base);
    font-weight: var(--font-body-weight);
    font-size: var(--font-body-200-size);
    line-height: var(--font-body-200-line);
    color: var(--color-grey-600);
  }

  /* Two copies of the button, one per breakpoint (see markup): desktop
     keeps it in .faq__intro beside the heading, mobile moves it after the
     question list — simpler than fighting the CSS grid/DOM order to
     relocate a single instance across such different layouts.
     :global() because <Button> renders its own root element under its own
     component scope, which a plain (auto-scoped) selector here can't reach —
     and the 3-class chain (rather than the class alone) is needed to
     out-specificity Button's own `.button[data-astro-cid-…]` rule, which
     would otherwise win the display tug-of-war regardless of source order. */
  :global(.faq .faq__grid .faq__cta--bottom) {
    display: none;
  }

  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: 1fr;
      /* Desktop's 64px column gap would otherwise still apply as a row gap
         once the columns stack, stacking on top of the two margin-top
         values below — zeroed out so those are the only spacing source. */
      gap: 0;
    }

    /* Desktop's margin-top trick (see .faq__list above) offsets the list
       against a two-column row that no longer exists once the columns
       stack — here the intro sits directly above the list, so the gap is
       just a flat 32px between the heading and the first question. */
    .faq__list {
      margin-top: var(--space-8);
    }

    :global(.faq .faq__intro .faq__cta--top) {
      display: none;
    }

    :global(.faq .faq__grid .faq__cta--bottom) {
      display: inline-flex;
      grid-column: 1;
      /* Grid items stretch to fill the column by default — without this the
         button (an inline-flex box, but blockified as a grid item) grows to
         the full grid width instead of hugging its own content. */
      justify-self: start;
      margin-top: var(--space-8);
    }
  }
</style>
