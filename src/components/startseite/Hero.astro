---
// Hero section — full-bleed class video loop over a static photo fallback,
// dark overlay, brand lockup + H1. Figma node 563:3895.
// The floating <Header> sits on top of this section.
import { Image } from "astro:assets";
import heroBg from "../../assets/startseite/hero_bg.jpg";
import heroVideo from "../../assets/startseite/hero_video.webm";
import glow from "../../assets/startseite/hero_decorative_glow.svg";
---

<section class="hero">
  <div class="hero__media">
    <Image
      src={heroBg}
      alt=""
      role="presentation"
      widths={[768, 1440, 2160]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={heroBg.src}
      aria-hidden="true"
      tabindex="-1"
      disablepictureinpicture
      disableremoteplayback
    >
      <source src={heroVideo} type="video/webm" />
    </video>
    <div class="hero__overlay"></div>
  </div>
  <img class="hero__glow" src={glow.src} alt="" aria-hidden="true" />

  <div class="container hero__content">
    <div class="hero__lockup">
      <span class="hero__adtv-badge">ADTV</span>
      <span class="hero__lockup-label">Tanzschule • Amaro</span>
    </div>
    <h1 class="hero__heading" data-split-heading>
      Willkommen in{" "}
      <br class="hero__heading-break" />
      <span class="hero__heading-line2">unserer Tanzfamilie</span>
      <span class="hero__since" data-since>est. 2006</span>
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Always fills the viewport on desktop (Figma's 780px-tall hero frame is
       a proportion reference at 1440px width, not a fixed pixel target —
       see the heading font-size below, which scales off this same 100vh). */
    height: 100vh;
    min-height: 560px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  /* Revealed by the script below once the video can play; the static photo
     stays visible underneath until then, and permanently if this never fires. */
  .hero__video.is-ready {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
  }

  .hero__glow {
    position: absolute;
    left: -200px;
    top: 180px;
    width: 1000px;
    height: 900px;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .hero__content {
    position: relative;
    /* .hero__content is the only in-flow child of .hero's flex row, so
       without an explicit width it shrinks to fit its text and .container's
       margin-inline: auto then centers that shrunk box — pushing the title
       way past the intended 64px. Stretch it to the full row and drop the
       centering so padding alone sets the inset. */
    width: 100%;
    max-width: none;
    margin-inline: 0;
    /* Mobile fallback (no mobile-frame spec given yet — token values, not
       invented pixels) until the 640px breakpoint below applies the exact
       Figma desktop inset. */
    padding-inline-start: var(--space-6); /* 24px */
    padding-bottom: var(--space-8); /* 32px */
  }

  @media (min-width: 640px) {
    .hero__content {
      /* Figma hero title inset: 64px left, matched on the bottom too (not the
         nominal 56px Figma value) — the "est. 2006" badge's own line box
         adds a few px of slack below the heading's tight line-height, so a
         touch less padding here lands the *visual* gap even with the side inset. */
      padding-inline-start: var(--space-16); /* 64px */
      padding-bottom: 3.125rem; /* 50px */
    }
  }

  .hero__lockup {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  /* Fades + slides up once Preloader.astro removes .has-preloader from
     <html> (see Header.astro for the matching nav animation). The heading
     itself doesn't join this — its words animate in individually instead,
     see the blur-in rules below. */
  :global(html.has-preloader) .hero__lockup {
    opacity: 0;
    transform: translateY(16px);
  }

  .hero__lockup {
    transition:
      opacity 0.7s ease 0.15s,
      transform 0.7s ease 0.15s;
  }

  .hero__adtv-badge {
    display: inline-flex;
    align-items: center;
    background: var(--color-green-300);
    color: var(--color-grey-950);
    font-family: var(--font-family-base);
    font-weight: var(--font-upper-weight);
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.04em;
    /* 6px/3px — Figma's exact ADTV Badge padding, not on the 4/8px scale */
    padding: 3px 6px;
    border-radius: 12px;
  }

  .hero__lockup-label {
    font-family: var(--font-family-base);
    font-weight: var(--font-upper-weight);
    font-size: var(--font-upper-100-size);
    letter-spacing: var(--font-upper-100-tracking);
    text-transform: uppercase;
    color: var(--color-grey-50);
  }

  .hero__heading {
    font-family: var(--font-family-base);
    font-weight: var(--font-title-weight);
    font-size: clamp(3.5rem, 8vw, var(--font-title-800-size)); /* 56px floor on mobile */
    line-height: var(--font-title-800-line);
    color: var(--color-grey-100);
    max-width: 20ch;
  }

  @media (min-width: 640px) {
    .hero__heading {
      /* Figma: 100px heading in a 780px-tall hero frame (1440 width) = 12.82vh.
         Since .hero is 100vh, this keeps the heading at the same proportion
         of the section on any desktop viewport height, instead of pinning it
         to the 100px the reference frame happened to use. */
      font-size: clamp(3.5rem, 12.82vh, 11.25rem);
    }
  }

  /* Word-by-word fade-up (JS-enhanced, GSAP SplitText — see script below,
     same engine/effect as CountdownCta.astro's result text). Words are
     hidden via inline styles the script sets at split time, not CSS, so
     no-JS / reduced-motion visitors simply get the plain, fully visible
     heading — nothing here can leave it stuck hidden. */

  /* "Willkommen in" / "unserer Tanzfamilie" is a fixed two-line split, not a
     width-dependent wrap. Below 640px the fixed hero title font floor (3.5rem)
     is too large for "unserer Tanzfamilie" to also fit on one line without
     overflowing, so nowrap only kicks in from tablet width up — narrower
     screens fall back to a natural (still word-boundary, not mid-word) wrap. */
  @media (min-width: 640px) {
    .hero__heading-line2 {
      white-space: nowrap;
    }
  }

  /* Held invisible until the preloader clears — no-JS/reduced-motion fallback
     for the GSAP-driven fade-up below (see the script), which hides this via
     inline styles and reveals it right after the heading's own words finish
     staggering in. */
  :global(html.has-preloader) .hero__since {
    opacity: 0;
  }

  /* Inline in the heading's own text flow (not a flex sibling) so it always
     sits right next to the last word, wrapping with the text at any width —
     matches Figma, where it sits baseline-aligned right after "Tanzfamilie". */
  .hero__since {
    display: inline-block;
    margin-left: var(--space-4);
    font-family: var(--font-family-base);
    font-weight: var(--font-title-weight);
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--color-green-300);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .hero {
      height: 90vh;
      min-height: 520px;
      max-height: 650px;
      /* Content sits mid-section on mobile instead of bottom-anchored
         (desktop keeps align-items: flex-end, matching Figma there). */
      align-items: center;
    }

    /* Centered layout on mobile (desktop stays left-aligned, matching Figma). */
    .hero__content {
      padding-inline: var(--space-6);
      padding-bottom: 0;
      text-align: center;
    }

    .hero__lockup {
      justify-content: center;
    }

    .hero__heading {
      margin-inline: auto;
    }

    /* Desktop's fixed "Willkommen in" / "unserer Tanzfamilie" split (see the
       markup) leaves each half too long to fit the mobile font floor
       (3.5rem) on its own, so it was wrapping *within* each half too —
       "Willkommen" / "in" / "unserer" / "Tanzfamilie". Dropping the hard
       break here lets all four words reflow as one run, landing "in" and
       "unserer" together on their own line per client feedback. */
    .hero__heading-break {
      display: none;
    }

    .hero__since {
      display: block;
      margin: var(--space-4) 0 0;
      text-align: center;
    }
  }
</style>

<script>
  // Fade the looping hero video in once it can actually play; the static photo
  // (also the video's poster) stays visible under it. Users who
  // prefer reduced motion, or who are on a metered/slow connection
  // (Save-Data on, or effectiveType 2g/slow-2g), never get the video at all
  // — the CSS hides it and this skips loading it too.
  const heroVideo = document.querySelector<HTMLVideoElement>(".hero__video");
  const connection = (navigator as any).connection;
  const isSlowConnection =
    connection && (connection.saveData || ["slow-2g", "2g"].includes(connection.effectiveType));

  if (heroVideo) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || isSlowConnection) {
      // Drop it from the DOM so the browser never fetches the video file.
      heroVideo.remove();
    } else {
      const reveal = () => {
        heroVideo.classList.add("is-ready");
        // Belt-and-braces: some browsers ignore the `autoplay` attribute
        // (e.g. after a mid-load pause) even though muted playback is
        // allowed. Nudge it explicitly; ignore rejection, the poster/photo
        // stays as the fallback either way.
        if (heroVideo.paused) heroVideo.play().catch(() => {});
      };
      if (heroVideo.readyState >= 3) {
        reveal();
      } else {
        heroVideo.addEventListener("canplay", reveal, { once: true });
      }

      // The browser has no reason to stop decoding a looping <video> once
      // it's scrolled out of view — measured it still happily decoding
      // frames all the way down at the footer. Pause it there and resume
      // if the user scrolls back up, instead of burning CPU/GPU on a video
      // nobody's looking at for the rest of the session.
      const visibilityObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            if (heroVideo.paused) heroVideo.play().catch(() => {});
          } else {
            heroVideo.pause();
          }
        },
        { threshold: 0 },
      );
      visibilityObserver.observe(heroVideo);
    }
  }
</script>

<script>
  // Reveals the hero heading word-by-word with a fade-up stagger (GSAP
  // SplitText), timed to the preloader's own fade-out — same trigger as the
  // rest of the hero's entrance animation (see the CSS above), and the same
  // effect/engine as CountdownCta.astro's result-text reveal.
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(SplitText);

  const heading = document.querySelector<HTMLElement>("[data-split-heading]");
  const since = document.querySelector<HTMLElement>("[data-since]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (heading && !reducedMotion) {
    // "est. 2006" gets its own (later) beat below, so it's excluded here
    // rather than staggering in as just two more words of the heading.
    const words = SplitText.create(heading, { type: "words", ignore: "[data-since]" }).words;
    gsap.set(words, { opacity: 0, y: 24 });
    if (since) gsap.set(since, { opacity: 0, y: 16 });

    function reveal() {
      const tl = gsap.timeline();
      tl.to(words, { opacity: 1, y: 0, duration: 0.7, stagger: 0.08, ease: "power2.out" });
      if (since) tl.to(since, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, "-=0.3");
    }

    // Preloader.astro always adds .has-preloader up front and removes it once
    // ready — on a first visit that's after the intro screen plays, on a
    // repeat visit (intro skipped this session) it's next frame instead. This
    // reveal replays on every page load either way; only the intro screen
    // itself is once-per-session, not this heading animation.
    const htmlEl = document.documentElement;
    if (htmlEl.classList.contains("has-preloader")) {
      const preloaderDone = new MutationObserver(() => {
        if (!htmlEl.classList.contains("has-preloader")) {
          preloaderDone.disconnect();
          reveal();
        }
      });
      preloaderDone.observe(htmlEl, { attributes: true, attributeFilter: ["class"] });
    } else {
      // Preloader.astro's markup is missing, so .has-preloader will never
      // clear on its own — reveal right away instead of leaving the words
      // stuck hidden.
      reveal();
    }
  }
</script>
