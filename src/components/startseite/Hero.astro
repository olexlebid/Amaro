---
// Hero section — full-bleed class video loop over a static photo fallback,
// dark overlay, brand lockup + H1. Figma node 563:3895.
// The floating <Header> sits on top of this section.
import { Image } from "astro:assets";
import heroBg from "../../assets/startseite/hero_bg.jpg";
import heroVideo from "../../assets/startseite/hero_video.webm";
import glow from "../../assets/startseite/hero_decorative_glow.svg";
---

<section class="hero">
  <div class="hero__media">
    <Image src={heroBg} alt="" role="presentation" widths={[768, 1440, 2160]} sizes="100vw" />
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={heroBg.src}
      aria-hidden="true"
      tabindex="-1"
      disablepictureinpicture
      disableremoteplayback
    >
      <source src={heroVideo} type="video/webm" />
    </video>
    <div class="hero__overlay"></div>
  </div>
  <img class="hero__glow" src={glow.src} alt="" aria-hidden="true" />

  <div class="container hero__content">
    <div class="hero__lockup">
      <span class="hero__adtv-badge">ADTV</span>
      <span class="hero__lockup-label">Tanzschule • Amaro</span>
    </div>
    <h1 class="hero__heading">
      Willkommen in unserer Tanzfamilie
      <span class="hero__since">est. 2006</span>
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 780px;
    max-height: 100vh;
    min-height: 560px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  /* Revealed by the script below once the video can play; the static photo
     stays visible underneath until then, and permanently if this never fires. */
  .hero__video.is-ready {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
  }

  .hero__glow {
    position: absolute;
    left: -200px;
    top: 180px;
    width: 1000px;
    height: 900px;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .hero__content {
    position: relative;
    padding-bottom: var(--space-16);
  }

  .hero__lockup {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .hero__adtv-badge {
    display: inline-flex;
    align-items: center;
    background: var(--color-green-300);
    color: var(--color-grey-950);
    font-family: var(--font-family-base);
    font-weight: var(--font-upper-weight);
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.04em;
    /* 6px/3px — Figma's exact ADTV Badge padding, not on the 4/8px scale */
    padding: 3px 6px;
    border-radius: 12px;
  }

  .hero__lockup-label {
    font-family: var(--font-family-base);
    font-weight: var(--font-upper-weight);
    font-size: var(--font-upper-100-size);
    letter-spacing: var(--font-upper-100-tracking);
    text-transform: uppercase;
    color: var(--color-grey-50);
  }

  .hero__heading {
    font-family: var(--font-family-base);
    font-weight: var(--font-title-weight);
    font-size: clamp(2.5rem, 8vw, var(--font-title-800-size));
    line-height: var(--font-title-800-line);
    color: var(--color-grey-100);
    max-width: 20ch;
  }

  /* Inline in the heading's own text flow (not a flex sibling) so it always
     sits right next to the last word, wrapping with the text at any width —
     matches Figma, where it sits baseline-aligned right after "Tanzfamilie". */
  .hero__since {
    display: inline-block;
    margin-left: var(--space-4);
    font-family: var(--font-family-base);
    font-weight: var(--font-title-weight);
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--color-green-300);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .hero {
      height: 90vh;
      min-height: 520px;
    }
  }
</style>

<script>
  // Fade the looping hero video in once it can actually play; the static photo
  // (also the video's poster) stays visible under it until then. Users who
  // prefer reduced motion never get the video at all — the CSS hides it and
  // this skips loading it too.
  const heroVideo = document.querySelector<HTMLVideoElement>(".hero__video");

  if (heroVideo) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      // Drop it from the DOM so the browser never fetches the video file.
      heroVideo.remove();
    } else {
      const reveal = () => {
        heroVideo.classList.add("is-ready");
        // Belt-and-braces: some browsers ignore the `autoplay` attribute
        // (e.g. after a mid-load pause) even though muted playback is
        // allowed. Nudge it explicitly; ignore rejection, the poster/photo
        // stays as the fallback either way.
        if (heroVideo.paused) heroVideo.play().catch(() => {});
      };
      if (heroVideo.readyState >= 3) {
        reveal();
      } else {
        heroVideo.addEventListener("canplay", reveal, { once: true });
      }
    }
  }
</script>
