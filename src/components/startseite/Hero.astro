---
// Hero section — full-bleed class video loop over a static photo fallback,
// dark overlay, brand lockup + H1. Figma node 563:3895.
// The floating <Header> sits on top of this section.
import { Image } from "astro:assets";
import heroBg from "../../assets/startseite/hero_bg.jpg";
import heroVideo from "../../assets/startseite/hero_video.webm";
import glow from "../../assets/startseite/hero_decorative_glow.svg";
---

<section class="hero">
  <div class="hero__media">
    <Image src={heroBg} alt="" role="presentation" widths={[768, 1440, 2160]} sizes="100vw" />
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={heroBg.src}
      aria-hidden="true"
      tabindex="-1"
      disablepictureinpicture
      disableremoteplayback
    >
      <source src={heroVideo} type="video/webm" />
    </video>
    <div class="hero__overlay"></div>
  </div>
  <img class="hero__glow" src={glow.src} alt="" aria-hidden="true" />

  <div class="container hero__content">
    <div class="hero__lockup">
      <span class="hero__adtv-badge">ADTV</span>
      <span class="hero__lockup-label">Tanzschule • Amaro</span>
    </div>
    <h1 class="hero__heading" data-blur-heading>
      <span class="hero__heading-word" data-word>Willkommen</span>
      <span class="hero__heading-word" data-word>in</span>
      <br />
      <span class="hero__heading-line2">
        <span class="hero__heading-word" data-word>unserer</span>
        <span class="hero__heading-word" data-word>Tanzfamilie</span>
      </span>
      <span class="hero__since">est. 2006</span>
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 780px;
    max-height: 100vh;
    min-height: 560px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  /* Revealed by the script below once the video can play; the static photo
     stays visible underneath until then, and permanently if this never fires. */
  .hero__video.is-ready {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
  }

  .hero__glow {
    position: absolute;
    left: -200px;
    top: 180px;
    width: 1000px;
    height: 900px;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .hero__content {
    position: relative;
    /* .hero__content is the only in-flow child of .hero's flex row, so
       without an explicit width it shrinks to fit its text and .container's
       margin-inline: auto then centers that shrunk box — pushing the title
       way past the intended 64px. Stretch it to the full row and drop the
       centering so padding alone sets the inset. */
    width: 100%;
    max-width: none;
    margin-inline: 0;
    /* Mobile fallback (no mobile-frame spec given yet — token values, not
       invented pixels) until the 640px breakpoint below applies the exact
       Figma desktop inset. */
    padding-inline-start: var(--space-6); /* 24px */
    padding-bottom: var(--space-8); /* 32px */
  }

  @media (min-width: 640px) {
    .hero__content {
      /* Figma hero title inset: 64px left, 56px bottom (fixed, not fluid). */
      padding-inline-start: var(--space-16); /* 64px */
      padding-bottom: 3.5rem; /* 56px — exact Figma value, not on the 4/8px scale */
    }
  }

  .hero__lockup {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  /* Fades + slides up once Preloader.astro removes .has-preloader from
     <html> (see Header.astro for the matching nav animation). The heading
     itself doesn't join this — its words animate in individually instead,
     see the blur-in rules below. */
  :global(html.has-preloader) .hero__lockup {
    opacity: 0;
    transform: translateY(16px);
  }

  .hero__lockup {
    transition:
      opacity 0.7s ease 0.15s,
      transform 0.7s ease 0.15s;
  }

  .hero__adtv-badge {
    display: inline-flex;
    align-items: center;
    background: var(--color-green-300);
    color: var(--color-grey-950);
    font-family: var(--font-family-base);
    font-weight: var(--font-upper-weight);
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.04em;
    /* 6px/3px — Figma's exact ADTV Badge padding, not on the 4/8px scale */
    padding: 3px 6px;
    border-radius: 12px;
  }

  .hero__lockup-label {
    font-family: var(--font-family-base);
    font-weight: var(--font-upper-weight);
    font-size: var(--font-upper-100-size);
    letter-spacing: var(--font-upper-100-tracking);
    text-transform: uppercase;
    color: var(--color-grey-50);
  }

  .hero__heading {
    font-family: var(--font-family-base);
    font-weight: var(--font-title-weight);
    font-size: clamp(3.5rem, 8vw, var(--font-title-800-size)); /* 56px floor on mobile */
    line-height: var(--font-title-800-line);
    color: var(--color-grey-100);
    max-width: 20ch;
  }

  /* Word-by-word blur-in (JS-enhanced, see script below) — a vanilla port of
     reactbits.dev's "Blur Text". Plain, fully visible text until the script
     opts a word into the "ready" (pre-animation, blurred/offset) state and
     then, once the preloader is gone, the "revealed" keyframe animation —
     so no JS / reduced motion just reads normally, never stuck blurred. */
  .hero__heading-word {
    display: inline-block;
    white-space: pre;
  }

  .hero__heading-word:not(:last-child)::after {
    content: " ";
  }

  .hero__heading--ready .hero__heading-word {
    filter: blur(10px);
    opacity: 0;
    transform: translateY(-24px);
  }

  .hero__heading--revealed .hero__heading-word {
    animation: hero-heading-word-in 0.7s linear both;
    animation-delay: var(--word-delay, 0s);
  }

  @keyframes hero-heading-word-in {
    0% {
      filter: blur(10px);
      opacity: 0;
      transform: translateY(-24px);
    }
    50% {
      filter: blur(5px);
      opacity: 0.5;
      transform: translateY(2px);
    }
    100% {
      filter: blur(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* "Willkommen in" / "unserer Tanzfamilie" is a fixed two-line split, not a
     width-dependent wrap. Below 640px the fixed hero title font floor (3.5rem)
     is too large for "unserer Tanzfamilie" to also fit on one line without
     overflowing, so nowrap only kicks in from tablet width up — narrower
     screens fall back to a natural (still word-boundary, not mid-word) wrap. */
  @media (min-width: 640px) {
    .hero__heading-line2 {
      white-space: nowrap;
    }
  }

  /* Inline in the heading's own text flow (not a flex sibling) so it always
     sits right next to the last word, wrapping with the text at any width —
     matches Figma, where it sits baseline-aligned right after "Tanzfamilie". */
  .hero__since {
    display: inline-block;
    margin-left: var(--space-4);
    font-family: var(--font-family-base);
    font-weight: var(--font-title-weight);
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--color-green-300);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .hero {
      height: 90vh;
      min-height: 520px;
      max-height: 650px;
      /* Content sits mid-section on mobile instead of bottom-anchored
         (desktop keeps align-items: flex-end, matching Figma there). */
      align-items: center;
    }

    /* Centered layout on mobile (desktop stays left-aligned, matching Figma). */
    .hero__content {
      padding-inline: var(--space-6);
      padding-bottom: 0;
      text-align: center;
    }

    .hero__lockup {
      justify-content: center;
    }

    .hero__heading {
      margin-inline: auto;
    }

    .hero__since {
      display: block;
      margin: var(--space-4) 0 0;
      text-align: center;
    }
  }
</style>

<script>
  // Fade the looping hero video in once it can actually play; the static photo
  // (also the video's poster) stays visible under it until then. Users who
  // prefer reduced motion never get the video at all — the CSS hides it and
  // this skips loading it too.
  const heroVideo = document.querySelector<HTMLVideoElement>(".hero__video");

  if (heroVideo) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      // Drop it from the DOM so the browser never fetches the video file.
      heroVideo.remove();
    } else {
      const reveal = () => {
        heroVideo.classList.add("is-ready");
        // Belt-and-braces: some browsers ignore the `autoplay` attribute
        // (e.g. after a mid-load pause) even though muted playback is
        // allowed. Nudge it explicitly; ignore rejection, the poster/photo
        // stays as the fallback either way.
        if (heroVideo.paused) heroVideo.play().catch(() => {});
      };
      if (heroVideo.readyState >= 3) {
        reveal();
      } else {
        heroVideo.addEventListener("canplay", reveal, { once: true });
      }
    }
  }
</script>

<script>
  // Reveals the hero heading word-by-word with a blur/fade/rise-in, timed to
  // the preloader's own fade-out — the same trigger the rest of the hero's
  // entrance animation uses (see the CSS above). Vanilla port of
  // reactbits.dev's "Blur Text" (framer-motion in the original; plain CSS
  // keyframes + a staggered animation-delay per word here instead, so this
  // doesn't need an extra animation library).
  const heading = document.querySelector<HTMLElement>("[data-blur-heading]");
  const words = Array.from(document.querySelectorAll<HTMLElement>("[data-word]"));
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (heading && words.length && !reducedMotion) {
    // Matches the delay={200} used in reactbits.dev's own usage example.
    const STAGGER_MS = 200;
    words.forEach((word, i) => {
      word.style.setProperty("--word-delay", `${i * STAGGER_MS}ms`);
    });

    // Preloader.astro always adds .has-preloader up front and removes it once
    // ready — on a first visit that's after the intro screen plays, on a
    // repeat visit (intro skipped this session) it's next frame instead. This
    // reveal replays on every page load either way; only the intro screen
    // itself is once-per-session, not this heading animation.
    const htmlEl = document.documentElement;
    if (htmlEl.classList.contains("has-preloader")) {
      // Blurred/offset "ready" state first, so there's no flash of the
      // fully visible heading before the preloader clears.
      heading.classList.add("hero__heading--ready");
      const preloaderDone = new MutationObserver(() => {
        if (!htmlEl.classList.contains("has-preloader")) {
          preloaderDone.disconnect();
          heading.classList.add("hero__heading--revealed");
        }
      });
      preloaderDone.observe(htmlEl, { attributes: true, attributeFilter: ["class"] });
    }
    // else: Preloader.astro's markup is missing, so nothing will ever clear
    // .has-preloader — leave the heading in its plain, fully visible resting
    // state rather than getting stuck blurred.
  }
</script>
