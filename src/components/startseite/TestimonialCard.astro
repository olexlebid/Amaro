---
// Single Google-review card, shared by Testimonials.astro's desktop marquee
// rows and its mobile horizontal-scroll row — same markup/sizing either way.
import starIcon from "../../assets/icons/star.svg";

interface Props {
  quote: string;
  author: string;
}

const { quote, author } = Astro.props;
---

<article class="testimonial-card">
  <p class="testimonial-card__quote">{quote}</p>
  <div class="testimonial-card__foot">
    <div class="testimonial-card__stars" aria-hidden="true">
      <img src={starIcon.src} alt="" /><img src={starIcon.src} alt="" /><img src={starIcon.src} alt="" /><img src={starIcon.src} alt="" /><img src={starIcon.src} alt="" />
    </div>
    <p class="testimonial-card__author">{author}</p>
  </div>
</article>

<style>
  .testimonial-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    width: 392px;
    height: 240px;
    padding: var(--space-6) var(--space-6) var(--space-4);
    background: var(--color-grey-200);
    border: 1px solid var(--color-grey-300);
    border-radius: 16px;
    flex-shrink: 0;
  }

  .testimonial-card__quote {
    font-family: var(--font-family-base);
    font-weight: var(--font-body-weight);
    font-size: var(--font-body-400-size);
    line-height: var(--font-body-400-line);
    color: var(--color-grey-700);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
  }

  .testimonial-card__foot {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .testimonial-card__stars {
    display: flex;
    gap: 2px;
  }

  .testimonial-card__stars img {
    width: 14px;
    height: 14px;
  }

  .testimonial-card__author {
    font-family: var(--font-family-base);
    font-weight: var(--font-body-weight);
    font-size: var(--font-body-100-size);
    color: var(--color-grey-500);
  }

  @media (max-width: 900px) {
    /* A bit narrower than a full phone-width card — leaves a sliver of the
       next card peeking in on the right, matching the mobile reference. */
    .testimonial-card {
      width: 78vw;
      height: auto;
      min-height: 240px;
      scroll-snap-align: start;
    }
  }
</style>
