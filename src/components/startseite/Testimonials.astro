---
// Google-review style testimonial wall. Desktop: two rows that scroll gently
// sideways (marquee). Mobile: a single native horizontally-scrollable/
// swipeable row with a scroll-position progress bar (Figma mobile frame has
// no room for two rows, and a passive marquee doesn't work with touch scroll
// underneath it, so mobile trades the loop for a user-driven swipe).
// Figma node 563:4012. All 8 quotes are real, verbatim customer reviews.
import Button from "../Button.astro";
import TestimonialCard from "./TestimonialCard.astro";
import starIcon from "../../assets/icons/star.svg";
import googleLogo from "../../assets/icons/google_reviews_logo.svg";

const rowOne = [
  {
    quote: "Bei der Tanzschule Amaro haben wir nicht nur Spaß beim Tanzen, wir haben auch viele neue Freunde kennengelernt!",
    author: "Annalena & Amalia, Hip Hop",
  },
  {
    quote: "Wir haben unseren Hochzeitstanz bei Martin gelernt und möchten uns ganz herzlich dafür bedanken. Er ist ein wirklich großartiger Tanzlehrer und hat sich viel Zeit für uns genommen …",
    author: "Lida M, Hochzeitstanz",
  },
  {
    quote: "Spaß steht natürlich an erster Stelle – aber meine Tochter ist selbstsicherer und mutiger durch das Tanzen geworden. Danke!",
    author: "Nicole & Ennie, Kindertanz",
  },
  {
    quote: "Hervorragende Tanzschule! Die Tanzschule Amaro hat vielleicht nicht die Reputation und den Ruf der „großen“ Tanzschule in Hannover, steht ihr aber qualitativ in Nichts nach …",
    author: "FJ G, Hip Hop",
  },
];

const rowTwo = [
  {
    quote: "Meine Verlobte und ich haben hier für unseren Hochzeitstanz geübt. Martin ist ein toller Lehrer und Mensch; er hat uns wirklich einen schönen Tanz beigebracht. Wir können die Tanzschule wirklich …",
    author: "DeJoo, Hip Hop",
  },
  {
    quote: "Three years ago, we decided to enroll our daughter in dance classes here, and it has proven to be absolutely the right decision. The school has a professional …",
    author: "Yi Wan, Hochzeitstanz",
  },
  {
    quote: "Die Tanzschule Amaro war für uns bei der Vorbereitung auf unseren Hochzeitstanz ein absoluter Glückstreffer. Wir sind beides Anfänger, aber Martin war für uns der perfekte Tanzlehrer, da er …",
    author: "Be Nhy, Kindertanz",
  },
  {
    quote: "Sehr nettes Team. Preis Top. Und das wichtigste, durch euch haben wir zu unserer Hochzeit so richtig geglänzt. Dankeschön",
    author: "Annalena und Amalia, Hip Hop",
  },
];

// Mobile shows every real review in one scrollable row instead of splitting
// them across two looping rows.
const allTestimonials = [...rowOne, ...rowTwo];
---

<section class="testimonials section" data-testimonials-section>
  <div class="container testimonials__header">
    <h2 class="testimonials__heading">Was unsere Kunden sagen</h2>
    <div class="testimonials__actions">
      <div class="testimonials__score">
        <img src={googleLogo.src} alt="" width="30" height="30" class="testimonials__google-logo" />
        <div class="testimonials__score-text">
          <div class="testimonials__stars" aria-hidden="true">
            <img src={starIcon.src} alt="" /><img src={starIcon.src} alt="" /><img src={starIcon.src} alt="" /><img src={starIcon.src} alt="" /><img src={starIcon.src} alt="" />
          </div>
          <span class="testimonials__score-label">4.8 score</span>
        </div>
      </div>
      <Button variant="tertiary" icon="right" href="https://maps.app.goo.gl/HJWZPPzghJUC49Z69" target="_blank" rel="noopener noreferrer">Mehr Bewertungen<span class="testimonials__cta-suffix"> auf Google</span></Button>
    </div>
  </div>

  <div class="testimonials__desktop">
    {[rowOne, rowTwo].map((row, i) => (
      <div class="testimonials__row" style={i === 1 ? "--direction: reverse" : ""}>
        <div class="testimonials__track">
          {[...row, ...row].map((item) => (
            <TestimonialCard quote={item.quote} author={item.author} />
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="testimonials__mobile">
    <div class="testimonials__mobile-track" data-testimonials-mobile-track>
      {allTestimonials.map((item) => (
        <TestimonialCard quote={item.quote} author={item.author} />
      ))}
    </div>
    <div class="container testimonials__mobile-progress-wrap">
      <div class="testimonials__progress">
        <div class="testimonials__progress-bar" data-testimonials-progress style={`width:${100 / allTestimonials.length}%; left:0;`}>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials {
    overflow: hidden;
  }

  .testimonials__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  .testimonials__heading {
    font-family: var(--font-family-base);
    font-weight: var(--font-title-weight);
    font-size: clamp(2.5rem, 6vw, var(--font-title-600-size));
    line-height: var(--font-title-600-line);
    color: var(--color-grey-900);
  }

  .testimonials__actions {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .testimonials__score {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .testimonials__google-logo {
    flex-shrink: 0;
  }

  .testimonials__score-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonials__stars {
    display: flex;
    gap: 2px;
  }

  .testimonials__stars img {
    width: 14px;
    height: 14px;
  }

  .testimonials__score-label {
    font-family: var(--font-family-base);
    font-size: 0.75rem;
    color: var(--color-grey-900);
  }

  /* Mobile-only single scroll row (see .testimonials__mobile below) — hidden
     on desktop, where the two looping rows in .testimonials__desktop run
     instead. */
  .testimonials__mobile {
    display: none;
  }

  .testimonials__row {
    --direction: normal;
    margin-bottom: var(--space-4);
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }

  .testimonials__track {
    display: flex;
    gap: var(--space-4);
    width: max-content;
    animation: marquee 60s linear infinite;
    animation-direction: var(--direction);
  }

  .testimonials__row:hover .testimonials__track {
    animation-play-state: paused;
  }

  /* Set by the script below via IntersectionObserver — the marquee has no
     reason to keep animating (and compositing two infinite-loop rows)
     while the section is scrolled out of view. */
  .testimonials.is-offscreen .testimonials__track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonials__track {
      animation: none;
      flex-wrap: wrap;
      overflow-x: auto;
    }
  }

  @media (max-width: 900px) {
    .testimonials__cta-suffix {
      display: none;
    }

    .testimonials__desktop {
      display: none;
    }

    .testimonials__mobile {
      display: block;
    }

    .testimonials__mobile-track {
      display: flex;
      gap: var(--space-4);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-inline: clamp(1rem, 4vw, var(--space-6));
    }

    .testimonials__mobile-track::-webkit-scrollbar {
      display: none;
    }

    .testimonials__mobile-progress-wrap {
      margin-top: var(--space-6);
    }

    .testimonials__progress {
      position: relative;
      height: 1px;
      background: var(--color-grey-300);
    }

    /* A scrollbar-style thumb, not a growing "how far scrolled" fill: width
       is how much of the row is visible at once (clientWidth/scrollWidth),
       left is the scroll position — so it reads correctly even at rest
       (scrollLeft 0), where a growing fill would render as empty. */
    .testimonials__progress-bar {
      position: absolute;
      top: 0;
      height: 1px;
      background: var(--color-grey-900);
    }

    @media (prefers-reduced-motion: no-preference) {
      .testimonials__progress-bar {
        /* Smooths over the gap between individual scroll-driven updates so
           the thumb reads as continuous rather than ticking in small steps. */
        transition: left 0.15s linear;
      }
    }
  }
</style>

<script>
  // Pauses the two infinite marquee rows while the section is scrolled out
  // of view — cheap on their own (transform-only), but no reason to keep
  // compositing an infinite animation nobody's looking at. Reduced-motion
  // visitors already get `animation: none` from the CSS above, so there's
  // nothing for this to do there. Runs regardless of viewport width — a
  // no-op below the mobile breakpoint, where the marquee rows are hidden
  // rather than removed from the DOM.
  const section = document.querySelector<HTMLElement>("[data-testimonials-section]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section && !reducedMotion) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        section.classList.toggle("is-offscreen", !entry.isIntersecting);
      },
      { threshold: 0 },
    );
    observer.observe(section);
  }

  // Mobile progress bar: a scrollbar-style thumb for the native
  // horizontally-scrollable row (see .testimonials__mobile-track) — width is
  // the visible fraction of the row, left is the scroll position.
  const mobileTrack = document.querySelector<HTMLElement>("[data-testimonials-mobile-track]");
  const progressBar = document.querySelector<HTMLElement>("[data-testimonials-progress]");

  if (mobileTrack && progressBar) {
    const updateProgress = () => {
      const widthFraction = Math.min(1, mobileTrack.clientWidth / mobileTrack.scrollWidth);
      const maxScroll = mobileTrack.scrollWidth - mobileTrack.clientWidth;
      const leftFraction = maxScroll > 0 ? mobileTrack.scrollLeft / mobileTrack.scrollWidth : 0;
      progressBar.style.width = `${widthFraction * 100}%`;
      progressBar.style.left = `${leftFraction * 100}%`;
    };

    let ticking = false;
    mobileTrack.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateProgress();
          ticking = false;
        });
      },
      { passive: true },
    );

    window.addEventListener("resize", updateProgress);
    updateProgress();
  }
</script>
