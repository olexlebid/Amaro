---
// Site header: floating nav that fills the page container edge-to-edge while
// transparent, then shrinks into a centered, blurred dark pill once the page
// is scrolled. Two mega-menu dropdowns (Tanzkurse, Über uns) and a mobile
// hamburger panel. Figma node refs: navbar unscrolled 579:300, navbar
// scrolled 579:326.
//
// NOTE: every internal href below is a placeholder ("#") — the target pages
// (Tanzangebot sub-pages, Stundenplan, Aktuelles, Kontakt, Über uns pages,
// Nimbus login...) don't exist yet. Swap these once each page is built.
//
// Copy, icon assignments and the two-column split below all come straight
// from Figma node 564:4982 (dropdown copy/type) and 516:430 (icon glyphs) —
// the promo panel's 3 bullets are still SaaS-template placeholder text
// ("Full-suite app for time, project and team management" etc.), unchanged
// since that part of the design hasn't been updated with real copy yet.
import Button from "./Button.astro";
import ArrowIcon from "./icons/ArrowIcon.astro";
import DropdownIcon from "./icons/DropdownIcon.astro";

// Two independent column stacks (not a strict row-major grid) — matches
// Figma, where col 1 holds the two tall cards (with tag chips) and col 2
// holds three shorter ones, stacked with no shared row heights between columns.
const tanzkurseCol1 = [
  {
    title: "Kindertanz & Hip-Hop",
    description:
      "Von den ersten Tanzschritten mit 3 Jahren bis zur eigenen Streetdance-Crew: für jedes Alter der passende Rhythmus.",
    tags: ["Mini Kids (3+)", "Kids (6+)", "Junioren (12+)", "Adults (16+)", "Classic"],
    icon: "headphones",
  },
  {
    title: "Masterclass",
    description: "Intensivtraining mit Gasttrainern, für alle mit Turnierambitionen.",
    tags: ["WazzUp Kids", "SunnyStars", "The Icons", "Drilla"],
    icon: "award",
  },
] as const;

const tanzkurseCol2 = [
  {
    title: "Hochzeitstanz",
    description: "Eure erste gemeinsame Choreografie, in wenigen Wochen einstudiert, ganz ohne Lampenfieber.",
    icon: "heart",
  },
  {
    title: "Schülerkurse",
    description: "Grundkurs, Bronzeball und der erste Tanz vor dem Abiball.",
    icon: "book",
  },
  {
    title: "Gesellschaftstanz",
    description: "Standard, Latein und ein fester Abend nur für euch beide in der Woche.",
    icon: "users",
  },
] as const;

const uberUnsItems = [
  { label: "Amaro Team", icon: "smile" },
  { label: "FAQs", icon: "info" },
  { label: "Mediathek", icon: "film" },
  { label: "Spotify Playlists", icon: "music" },
  { label: "Feiern bei uns", icon: "gift" },
  { label: "Amaro Shop", icon: "package" },
] as const;
---

<header class="header" data-header>
  <!-- Mobile-only dimmed backdrop behind the open menu panel — painted
       before .header__container so it stacks underneath it. -->
  <div class="header__scrim" data-mobile-scrim hidden></div>

  <div class="header__container container">
    <nav class="header__navbar" data-navbar aria-label="Hauptnavigation">
      <a class="header__logo" href="/" aria-label="Tanzschule Amaro — Startseite">
        <img class="header__logo-img" src="/logo/amaro-logo-white.svg" alt="" width="86" height="40" />
      </a>

      <ul class="header__links">
        <li class="header__item">
          <button
            class="header__link"
            type="button"
            aria-expanded="false"
            aria-controls="dropdown-tanzkurse"
            data-dropdown-trigger="tanzkurse"
          >
            Tanzkurse
            <svg class="header__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </li>
        <li class="header__item"><a class="header__link" href="#">Stundenplan</a></li>
        <li class="header__item">
          <button
            class="header__link"
            type="button"
            aria-expanded="false"
            aria-controls="dropdown-ueber-uns"
            data-dropdown-trigger="ueber-uns"
          >
            Über uns
            <svg class="header__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </li>
        <li class="header__item"><a class="header__link" href="#">Kontakt</a></li>
      </ul>

      <div class="header__cta">
        <a class="header__login" href="#">Login</a>
        <a class="header__cta-button" href="#">
          <!-- TODO: Nimbus Cloud -->
          Probestunde
        </a>
      </div>
      <!-- Tanzkurse mega-menu -->
      <div class="header__dropdown" id="dropdown-tanzkurse" data-dropdown-panel="tanzkurse" hidden>
        <div class="header__dropdown-inner">
          <p class="header__dropdown-title header__dropdown-title--eyebrow">Unsere Tanzangebot</p>
          <div class="tanzkurse-grid">
            <div class="tanzkurse-col">
              {tanzkurseCol1.map((item) => (
                <a class="tanzkurse-card" href="#">
                  <div class="tanzkurse-card__head">
                    <span class="tanzkurse-card__badge" aria-hidden="true"><DropdownIcon name={item.icon} /></span>
                    <span class="tanzkurse-card__title">{item.title}</span>
                    <span class="tanzkurse-card__arrow">
                      <span class="tanzkurse-card__arrow-wrap">
                        <ArrowIcon size={16} class="tanzkurse-card__arrow-icon tanzkurse-card__arrow-icon--out" />
                        <ArrowIcon size={16} class="tanzkurse-card__arrow-icon tanzkurse-card__arrow-icon--in" />
                      </span>
                    </span>
                  </div>
                  <p class="tanzkurse-card__desc">{item.description}</p>
                  {item.tags && (
                    <ul class="tanzkurse-card__tags">
                      {item.tags.map((tag) => (
                        <li class="tanzkurse-card__tag">{tag}</li>
                      ))}
                    </ul>
                  )}
                </a>
              ))}
            </div>
            <div class="tanzkurse-col">
              {tanzkurseCol2.map((item) => (
                <a class="tanzkurse-card" href="#">
                  <div class="tanzkurse-card__head">
                    <span class="tanzkurse-card__badge" aria-hidden="true"><DropdownIcon name={item.icon} /></span>
                    <span class="tanzkurse-card__title">{item.title}</span>
                    <span class="tanzkurse-card__arrow">
                      <span class="tanzkurse-card__arrow-wrap">
                        <ArrowIcon size={16} class="tanzkurse-card__arrow-icon tanzkurse-card__arrow-icon--out" />
                        <ArrowIcon size={16} class="tanzkurse-card__arrow-icon tanzkurse-card__arrow-icon--in" />
                      </span>
                    </span>
                  </div>
                  <p class="tanzkurse-card__desc">{item.description}</p>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
      <!-- Über uns dropdown -->
      <div class="header__dropdown" id="dropdown-ueber-uns" data-dropdown-panel="ueber-uns" hidden>
        <div class="header__dropdown-inner">
          <p class="header__dropdown-title header__dropdown-title--eyebrow">Über uns</p>
          <ul class="ueberuns-grid">
            {uberUnsItems.map((item) => (
              <li>
                <a class="ueberuns-item" href="#">
                  <span class="ueberuns-item__badge" aria-hidden="true"><DropdownIcon name={item.icon} /></span>
                  <span class="ueberuns-item__label">{item.label}</span>
                  <span class="ueberuns-item__arrow-wrap">
                    <ArrowIcon size={20} class="ueberuns-item__arrow ueberuns-item__arrow--out" />
                    <ArrowIcon size={20} class="ueberuns-item__arrow ueberuns-item__arrow--in" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <!-- Mobile-only: a flex child of the navbar itself (not a container
           sibling) so it shares the exact same pill background as the logo,
           below ~960px, instead of needing its own separate one. -->
      <button
        class="header__burger"
        type="button"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-panel"
        data-mobile-toggle
      >
        <span class="header__burger-bar"></span>
        <span class="header__burger-bar"></span>
        <span class="header__burger-bar"></span>
      </button>
    </nav>
    <!-- Mobile menu panel — a flex child of header__container so it inherits
         the same container inset as the navbar row above it, wrapping onto
         its own line via flex-basis: 100% below. -->
    <div class="header__mobile-panel" id="mobile-panel" data-mobile-panel hidden>
      <ul class="mobile-panel__links">
        <li>
          <details class="mobile-panel__group">
            <summary>
              Tanzkurse
              <svg class="mobile-panel__chevron" width="12" height="7" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <ul>
              {[...tanzkurseCol1, ...tanzkurseCol2].map((item) => (
                <li><a href="#">{item.title}</a></li>
              ))}
            </ul>
          </details>
        </li>
        <li><a href="#">Stundenplan</a></li>
        <li>
          <details class="mobile-panel__group">
            <summary>
              Über uns
              <svg class="mobile-panel__chevron" width="12" height="7" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <ul>
              {uberUnsItems.map((item) => (
                <li><a href="#">{item.label}</a></li>
              ))}
            </ul>
          </details>
        </li>
        <li><a href="#">Kontakt</a></li>
        <li><a href="#">Login</a></li>
      </ul>
      <Button variant="primary" icon="none" href="#" fullWidth class="mobile-panel__cta">Probestunde buchen</Button>
    </div>
  </div>
</header>

<script>
  // Toggle the header's "scrolled" state (Figma navbar 579:300 "unscrolled" vs
  // 579:326 "scrolled") and wire up the dropdown / mobile-menu interactions
  // with keyboard support.
  const header = document.querySelector<HTMLElement>("[data-header]");
  const navbar = document.querySelector<HTMLElement>("[data-navbar]");

  // Scroll distance after which the navbar collapses into the dark pill.
  const SCROLL_THRESHOLD = 100;

  // Horizontal padding of the *scrolled* pill only (space-6 + space-2 =
  // 24px + 8px — see ".header--scrolled .header__navbar" below). The
  // unscrolled navbar has no horizontal padding (it sits flush with the
  // container edges instead), so this can't be read off the navbar's
  // current computed style — it has to match the CSS value directly.
  const SCROLLED_PADDING_X = 32;

  // The navbar always spans the full container width while transparent
  // (unscrolled). Once scrolled, it shrinks to hug its own content instead —
  // but keeps the navbar's own `gap` as a minimum breathing room between the
  // logo / links / CTA groups (matching Figma 579:326, which still has ~64px
  // between them even in the collapsed pill). To animate that shrink smoothly
  // we measure the content's natural width up front and drive the collapse
  // via a CSS custom property, rather than transitioning to/from an
  // unmeasurable "auto" width.
  function updateCollapsedWidth() {
    if (!navbar) return;
    const measured = navbar.querySelectorAll<HTMLElement>(
      ":scope > .header__logo, :scope > .header__links, :scope > .header__cta",
    );
    let contentWidth = 0;
    measured.forEach((el) => {
      contentWidth += el.getBoundingClientRect().width;
    });
    const gap = parseFloat(getComputedStyle(navbar).columnGap) || 0;
    const gapsCount = Math.max(measured.length - 1, 0);
    navbar.style.setProperty(
      "--navbar-collapsed-width",
      `${contentWidth + SCROLLED_PADDING_X + gap * gapsCount}px`,
    );
  }

  const onScroll = () => {
    if (!header) return;
    header.classList.toggle("header--scrolled", window.scrollY > SCROLL_THRESHOLD);
  };

  updateCollapsedWidth();
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", updateCollapsedWidth);
  document.fonts?.ready?.then(updateCollapsedWidth);

  const triggers = document.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger]");
  const panels = document.querySelectorAll<HTMLElement>("[data-dropdown-panel]");

  function closeAllDropdowns() {
    triggers.forEach((trigger) => trigger.setAttribute("aria-expanded", "false"));
    panels.forEach((panel) => (panel.hidden = true));
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const name = trigger.dataset.dropdownTrigger;
      const panel = document.querySelector<HTMLElement>(`[data-dropdown-panel="${name}"]`);
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      closeAllDropdowns();
      if (!isOpen && panel) {
        trigger.setAttribute("aria-expanded", "true");
        panel.hidden = false;
      }
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeAllDropdowns();
  });

  document.addEventListener("click", (event) => {
    if (!header?.contains(event.target as Node)) closeAllDropdowns();
  });

  // Mobile hamburger toggle
  const mobileToggle = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
  const mobilePanel = document.querySelector<HTMLElement>("[data-mobile-panel]");
  const mobileScrim = document.querySelector<HTMLElement>("[data-mobile-scrim]");

  function closeMobileMenu() {
    mobileToggle?.setAttribute("aria-expanded", "false");
    if (mobilePanel) mobilePanel.hidden = true;
    if (mobileScrim) mobileScrim.hidden = true;
    document.documentElement.classList.remove("has-mobile-menu");
  }

  mobileToggle?.addEventListener("click", () => {
    const isOpen = mobileToggle.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMobileMenu();
      return;
    }
    mobileToggle.setAttribute("aria-expanded", "true");
    if (mobilePanel) mobilePanel.hidden = false;
    if (mobileScrim) mobileScrim.hidden = false;
    // Block the page behind from scrolling while the panel is open — the
    // panel itself still scrolls internally (see its own max-height/overflow).
    document.documentElement.classList.add("has-mobile-menu");
  });

  // Tapping the dimmed backdrop closes the menu, same as tapping the burger again.
  mobileScrim?.addEventListener("click", closeMobileMenu);
</script>

<style>
  .header {
    position: fixed;
    top: var(--space-6);
    left: 0;
    right: 0;
    z-index: 50;
    /* The shrunk (scrolled) pill no longer spans the full row — let clicks
       pass through the empty space on either side of it to the page content
       underneath. Re-enabled below on the actual interactive pieces. */
    pointer-events: none;
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;

    /* State tokens — swapped by .header--scrolled below (Figma navbar 579:300 vs 579:326) */
    --header-text: var(--color-grey-200);
    --header-cta-gap: var(--space-3);
  }

  /* Starts hidden while the Lottie preloader (BaseLayout) is up, then fades
     and slides in once Preloader.astro removes this class from <html>. */
  :global(html.has-preloader) .header {
    opacity: 0;
    transform: translateY(-16px);
  }

  /* Set on <html> by the mobile toggle script below while the panel is
     open, so the page behind it can't scroll. */
  :global(html.has-mobile-menu) {
    overflow: hidden;
  }

  /* Dimmed backdrop behind the open mobile panel — toggled via [hidden] by
     the same script, right alongside the panel itself. */
  .header__scrim {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    pointer-events: auto;
  }

  .header--scrolled {
    --header-text: var(--color-grey-100);
    --header-cta-gap: var(--space-2);
    /* Desktop only — once scrolled into the collapsed dark pill, it sits
       closer to the top edge (16px) than the unscrolled navbar's 24px
       (`.header`'s base `top` above). Below 960px this is moot: the mobile
       media query further down sets `top` to the same 16px unconditionally. */
    top: var(--space-4);
  }

  .header__container {
    /* Positioned (with a higher z-index than .header__scrim) so it reliably
       stacks above that scrim — a fixed-position sibling would otherwise
       paint on top of this regardless of DOM order, since this itself
       wasn't a positioned element before. */
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    /* .container's fluid clamp() gutter doesn't match the Hero title's inset
       (see Hero.astro .hero__content) — both need the same fixed Figma edge
       so the logo/CTA line up with the title below. Override the same way
       Hero does: drop the fluid centered max-width, use a flat inset. */
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: var(--space-6); /* 24px mobile fallback */
  }

  @media (min-width: 640px) {
    .header__container {
      padding-inline: var(--space-16); /* 64px — exact Figma inset, matches Hero */
    }
  }

  .header__navbar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    width: 100%;
    background: transparent;
    border-radius: 32px;
    /* Unscrolled: no horizontal padding, so the logo/CTA sit flush with the
       container edges — the same edges the page content (e.g. the Hero
       title) aligns to. The 24px/8px pill padding only applies once
       scrolled, where it gives the visible dark pill room to breathe. */
    padding: var(--space-2) 0;
    pointer-events: auto;
    transition:
      width 0.4s ease,
      padding-inline 0.4s ease,
      background-color 0.3s ease;
    /* `width`/`padding-inline` above force a layout recalc on every frame of
       the 0.4s collapse transition (measured via a Chrome performance trace:
       ~20 layout shifts, one per frame, right as scroll starts). `position:
       relative` already makes this element the containing block for
       .header__dropdown's own `position: absolute`, so scoping layout here
       changes nothing visually — it just stops the browser from having to
       check whether the resize needs to propagate beyond this one element. */
    contain: layout style;
  }

  .header--scrolled .header__navbar {
    width: var(--navbar-collapsed-width, auto);
    /* 2px less than the unscrolled state's `var(--space-2)` top/bottom (see
       above) — 4px off the pill's total height — no blur (see below), so
       trimming the padding keeps the pill from reading as too tall next to
       the now-crisp edge. */
    padding: calc(var(--space-2) - 2px) var(--space-2) calc(var(--space-2) - 2px) var(--space-6);
    /* Was `rgba(0, 0, 0, 0.6)` + `backdrop-filter: blur(20px)` — the blur
       showed up as a real cost in a perf trace (a blurred backdrop-filter
       forces the browser to repaint everything behind the pill on every
       scroll frame). A flat, near-opaque fill reads the same at a glance
       and costs nothing to repaint. */
    background: color-mix(in srgb, var(--color-grey-900) 95%, transparent);
  }

  .header__logo {
    display: block;
    flex-shrink: 0;
    width: 86px;
    height: 40px;
  }

  .header__logo-img {
    width: 86px;
    height: 40px;
  }

  .header__links {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: 24px;
    font-family: var(--font-family-base);
    font-weight: 500;
    font-size: 1rem;
    color: var(--header-text);
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }

  .header__item:has([aria-expanded="true"]) .header__link,
  .header__link:hover,
  .header__link:focus-visible {
    background: rgba(255, 255, 255, 0.1);
  }

  .header__chevron {
    color: currentColor;
  }

  .header__cta {
    display: flex;
    align-items: center;
    gap: var(--header-cta-gap);
    flex-shrink: 0;
  }

  .header__login,
  .header__cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding-inline: var(--space-4);
    border-radius: 32px;
    font-family: var(--font-family-base);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .header__login {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-grey-100);
    transition: background-color 0.15s ease;
  }

  .header__cta-button {
    background: var(--color-grey-100);
    color: var(--color-grey-950);
    transition: opacity 0.15s ease;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 901px) {
    /* 10% lighter — bump the translucent white fill's own alpha by 0.1. */
    .header__login:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    /* 10% more transparent — the pill is solid white, so this fades the
       whole button rather than switching to an rgba fill. */
    .header__cta-button:hover {
      opacity: 0.9;
    }
  }

  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    pointer-events: auto;
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }

  .header__burger-bar {
    display: block;
    width: 18px;
    height: 1.6px;
    margin-inline: auto;
    background: var(--color-grey-100);
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }

  /* Hamburger → X, driven by the button's own aria-expanded (already toggled
     by the script below) — no extra class needed. The two outer bars slide
     to the middle bar's position (half the 4px gap + its own height) and
     rotate into an X; the middle bar just fades out. */
  .header__burger[aria-expanded="true"] .header__burger-bar:nth-child(1) {
    transform: translateY(5.6px) rotate(45deg);
  }

  .header__burger[aria-expanded="true"] .header__burger-bar:nth-child(2) {
    opacity: 0;
  }

  .header__burger[aria-expanded="true"] .header__burger-bar:nth-child(3) {
    transform: translateY(-5.6px) rotate(-45deg);
  }

  /* --- Dropdown panels --- */
  /* Centered under the navbar (not edge-to-edge) and capped at 900px, so
     both panels line up the same way regardless of the navbar's own current
     width (full container when unscrolled vs. the shrunk pill when scrolled). */
  .header__dropdown {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 50%;
    transform: translateX(-50%);
    transform-origin: top center;
    width: 100%;
    max-width: 900px;
    background: var(--color-grey-50);
    border: 1px solid var(--color-grey-300);
    border-radius: 16px;
    box-shadow: 0 24px 48px var(--color-grey-20p);
  }

  .header__dropdown-inner {
    padding: var(--space-8);
  }

  /* Plain heading style — used as-is by the Über uns dropdown ("Über uns"). */
  .header__dropdown-title {
    font-family: var(--font-family-base);
    font-weight: 500;
    font-size: 1.125rem;
    letter-spacing: 0.01em;
    color: var(--color-grey-800);
    margin-bottom: var(--space-4);
  }

  /* Small-caps eyebrow variant — used by the Tanzkurse dropdown ("Unsere
     Tanzangebot"), same upper-100 tokens as the hero's ADTV badge/label. */
  .header__dropdown-title--eyebrow {
    font-weight: var(--font-upper-weight);
