---
// Site header: floating pill nav with two mega-menu dropdowns (Tanzkurse, Über
// uns), a scroll-triggered color swap (Figma "Default" vs "Variant2"), and a
// mobile hamburger panel. Figma node refs: header 466:966, dropdowns 564:4982.
//
// NOTE: every internal href below is a placeholder ("#") — the target pages
// (Tanzangebot sub-pages, Stundenplan, Aktuelles, Kontakt, Über uns pages...)
// don't exist yet. Swap these once each page is built.
//
// The 5 short blurbs in the Tanzkurse dropdown and the 3 bullets in its promo
// panel were SaaS-template placeholder text in Figma ("Full-suite app for
// time, project and team management" etc.) — drafted here in German instead,
// to be reviewed against the real Figma copy once it's updated there.
import Button from "./Button.astro";
import ArrowIcon from "./icons/ArrowIcon.astro";

const tanzkurseItems = [
  {
    title: "Kindertanz & Hip-Hop",
    description: "Tanzspaß für Kinder und Jugendliche von 3 bis 18 Jahren",
    tags: ["Mini Kids (3+)", "Kids (6+)", "Junioren (12+)", "Adults (16+)", "Classic"],
  },
  {
    title: "Masterclass",
    description: "Intensivtraining und Wettkampfvorbereitung für unsere Teams",
  },
  {
    title: "Gesellschaftstanz",
    description: "Standard und Latein für Paare jeden Alters und Levels",
  },
  {
    title: "Hochzeitstanz",
    description: "Dein perfekter erster Tanz — in nur wenigen Stunden",
  },
  {
    title: "Schülerkurse",
    description: "Tanzkurse und Bälle für Schülerinnen und Schüler",
  },
];

const uberUnsItems = [
  "Amaro Team",
  "FAQs",
  "Mediathek",
  "Spotify Playlists",
  "Feiern bei uns",
  "Amaro Shop",
];
---

<header class="header" data-header>
  <div class="header__bar">
    <nav class="header__navbar" aria-label="Hauptnavigation">
      <a class="header__logo" href="/" aria-label="Tanzschule Amaro — Startseite">
        <img class="header__logo-img header__logo-img--light" src="/logo/amaro-logo-white.svg" alt="" width="86" height="40" />
        <img class="header__logo-img header__logo-img--dark" src="/logo/amaro-logo-dark.svg" alt="" width="86" height="40" />
      </a>

      <ul class="header__links">
        <li class="header__item">
          <button
            class="header__link"
            type="button"
            aria-expanded="false"
            aria-controls="dropdown-tanzkurse"
            data-dropdown-trigger="tanzkurse"
          >
            Tanzkurse
            <svg class="header__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </li>
        <li class="header__item"><a class="header__link" href="#">Stundenplan</a></li>
        <li class="header__item"><a class="header__link" href="#">Aktuelles</a></li>
        <li class="header__item">
          <button
            class="header__link"
            type="button"
            aria-expanded="false"
            aria-controls="dropdown-ueber-uns"
            data-dropdown-trigger="ueber-uns"
          >
            Über uns
            <svg class="header__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </li>
        <li class="header__item"><a class="header__link" href="#">Kontakt</a></li>
      </ul>
    </nav>

    <div class="header__cta">
      <a class="header__member-link" href="#">Mitgliedportal</a>
      <a class="header__cta-button" href="#"><!-- TODO: Nimbus Cloud -->Probestunde</a>
    </div>

    <button
      class="header__burger"
      type="button"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mobile-panel"
      data-mobile-toggle
    >
      <span class="header__burger-bar"></span>
      <span class="header__burger-bar"></span>
      <span class="header__burger-bar"></span>
    </button>
  </div>

  <!-- Tanzkurse mega-menu -->
  <div class="header__dropdown" id="dropdown-tanzkurse" data-dropdown-panel="tanzkurse" hidden>
    <div class="header__dropdown-inner">
      <p class="header__dropdown-title">Unsere Tanzangebot</p>
      <div class="tanzkurse-grid">
        {tanzkurseItems.map((item) => (
          <a class="tanzkurse-card" href="#">
            <div class="tanzkurse-card__head">
              <span class="tanzkurse-card__badge" aria-hidden="true"></span>
              <span class="tanzkurse-card__title">{item.title}</span>
              <span class="tanzkurse-card__arrow"><ArrowIcon size={16} /></span>
            </div>
            <p class="tanzkurse-card__desc">{item.description}</p>
            {item.tags && (
              <ul class="tanzkurse-card__tags">
                {item.tags.map((tag) => (
                  <li class="tanzkurse-card__tag">{tag}</li>
                ))}
              </ul>
            )}
          </a>
        ))}
      </div>
      <div class="tanzkurse-promo">
        <p class="tanzkurse-promo__title">Fünf, sechs, sieben, acht.</p>
        <ul class="tanzkurse-promo__list">
          <li>Kostenlose Probestunde in jedem Kurs</li>
          <li>Zertifizierte ADTV-Trainer:innen</li>
          <li>Familiäre Atmosphäre in Hannover-Badenstedt</li>
        </ul>
        <Button variant="white" icon="none" href="#" class="tanzkurse-promo__button">Probestunde anfragen</Button>
      </div>
    </div>
  </div>

  <!-- Über uns dropdown -->
  <div class="header__dropdown header__dropdown--narrow" id="dropdown-ueber-uns" data-dropdown-panel="ueber-uns" hidden>
    <div class="header__dropdown-inner">
      <p class="header__dropdown-title">Über uns</p>
      <ul class="ueberuns-grid">
        {uberUnsItems.map((label) => (
          <li>
            <a class="ueberuns-item" href="#">
              <span class="ueberuns-item__badge" aria-hidden="true"></span>
              <span class="ueberuns-item__label">{label}</span>
              <ArrowIcon size={20} class="ueberuns-item__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div class="header__mobile-panel" id="mobile-panel" data-mobile-panel hidden>
    <ul class="mobile-panel__links">
      <li>
        <details class="mobile-panel__group">
          <summary>Tanzkurse</summary>
          <ul>
            {tanzkurseItems.map((item) => (
              <li><a href="#">{item.title}</a></li>
            ))}
          </ul>
        </details>
      </li>
      <li><a href="#">Stundenplan</a></li>
      <li><a href="#">Aktuelles</a></li>
      <li>
        <details class="mobile-panel__group">
          <summary>Über uns</summary>
          <ul>
            {uberUnsItems.map((label) => (
              <li><a href="#">{label}</a></li>
            ))}
          </ul>
        </details>
      </li>
      <li><a href="#">Kontakt</a></li>
      <li><a href="#">Mitgliedportal</a></li>
    </ul>
    <Button variant="primary" icon="none" href="#" class="mobile-panel__cta">Probestunde buchen</Button>
  </div>
</header>

<script>
  // Toggle the header's "scrolled" state (Figma Header "Default" vs "Variant2")
  // and wire up the dropdown / mobile-menu interactions with keyboard support.
  const header = document.querySelector<HTMLElement>("[data-header]");

  const onScroll = () => {
    if (!header) return;
    header.classList.toggle("header--scrolled", window.scrollY > 8);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const triggers = document.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger]");
  const panels = document.querySelectorAll<HTMLElement>("[data-dropdown-panel]");

  function closeAllDropdowns() {
    triggers.forEach((trigger) => trigger.setAttribute("aria-expanded", "false"));
    panels.forEach((panel) => (panel.hidden = true));
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const name = trigger.dataset.dropdownTrigger;
      const panel = document.querySelector<HTMLElement>(`[data-dropdown-panel="${name}"]`);
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      closeAllDropdowns();
      if (!isOpen && panel) {
        trigger.setAttribute("aria-expanded", "true");
        panel.hidden = false;
      }
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeAllDropdowns();
  });

  document.addEventListener("click", (event) => {
    if (!header?.contains(event.target as Node)) closeAllDropdowns();
  });

  // Mobile hamburger toggle
  const mobileToggle = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
  const mobilePanel = document.querySelector<HTMLElement>("[data-mobile-panel]");

  mobileToggle?.addEventListener("click", () => {
    const isOpen = mobileToggle.getAttribute("aria-expanded") === "true";
    mobileToggle.setAttribute("aria-expanded", String(!isOpen));
    if (mobilePanel) mobilePanel.hidden = isOpen;
  });
</script>

<style>
  .header {
    position: fixed;
    top: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    width: min(1408px, calc(100% - 32px));
    z-index: 50;
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;

    /* State tokens — swapped by .header--scrolled below (Figma Default/Variant2) */
    --header-pill-bg: rgba(255, 255, 255, 0.1);
    --header-pill-border: rgba(255, 255, 255, 0.16);
    --header-text: #eaeaea;
    --header-cta-bg: rgba(255, 255, 255, 0.1);
    --header-cta-border: rgba(255, 255, 255, 0.16);
    --header-button-bg: rgba(255, 255, 255, 0.9);
    --header-button-text: var(--color-grey-950);
  }

  /* Starts hidden while the Lottie preloader (BaseLayout) is up, then fades
     and slides in once Preloader.astro removes this class from <html>. The
     translateX(-50%) here must stay — it's what centers the pill — only the
     translateY is what's actually being revealed. */
  :global(html.has-preloader) .header {
    opacity: 0;
    transform: translateX(-50%) translateY(-16px);
  }

  .header--scrolled {
    --header-pill-bg: rgba(255, 255, 255, 0.9);
    --header-pill-border: var(--color-grey-10p);
    --header-text: #1c1c1c;
    --header-cta-bg: rgba(255, 255, 255, 0.96);
    --header-cta-border: #cecdca;
    --header-button-bg: #1c1c1c;
    --header-button-text: var(--color-grey-50);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .header__navbar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    background: var(--header-pill-bg);
    border: 1px solid var(--header-pill-border);
    border-radius: 32px;
    padding: var(--space-2) var(--space-6);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }

  .header__logo {
    display: block;
    flex-shrink: 0;
    width: 86px;
    height: 40px;
  }

  .header__logo-img {
    width: 86px;
    height: 40px;
  }

  .header__logo-img--dark {
    display: none;
  }

  .header--scrolled .header__logo-img--light {
    display: none;
  }

  .header--scrolled .header__logo-img--dark {
    display: block;
  }

  .header__links {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-radius: 24px;
    font-family: var(--font-family-base);
    font-weight: 500;
    font-size: 1rem;
    color: var(--header-text);
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }

  .header__item:has([aria-expanded="true"]) .header__link,
  .header__link:hover,
  .header__link:focus-visible {
    background: var(--color-grey-5p);
  }

  .header__chevron {
    color: currentColor;
  }

  .header__cta {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    background: var(--header-cta-bg);
    border: 1px solid var(--header-cta-border);
    border-radius: 32px;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-6);
    flex-shrink: 0;
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }

  .header__member-link {
    font-family: var(--font-family-base);
    font-weight: 500;
    font-size: 1rem;
    color: var(--header-text);
    white-space: nowrap;
  }

  .header__cta-button {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding-inline: var(--space-4);
    border-radius: 32px;
    background: var(--header-button-bg);
    color: var(--header-button-text);
    font-family: var(--font-family-base);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--header-pill-bg);
    border: 1px solid var(--header-pill-border);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }

  .header__burger-bar {
    display: block;
    width: 18px;
    height: 1.6px;
    margin-inline: auto;
    background: var(--header-text);
  }

  /* --- Dropdown panels --- */
  .header__dropdown {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    right: 0;
    background: var(--color-grey-50);
    border: 1px solid var(--color-grey-300);
    border-radius: 16px;
    box-shadow: 0 24px 48px var(--color-grey-20p);
  }

  .header__dropdown--narrow {
    left: 0;
    right: auto;
    min-width: 620px;
  }

  .header__dropdown-inner {
    padding: var(--space-8);
  }

  .header__dropdown-title {
    font-family: var(--font-family-base);
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--color-grey-900);
    margin-bottom: var(--space-4);
  }

  /* Tanzkurse grid */
  .tanzkurse-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .tanzkurse-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-3);
    border: 1px solid var(--color-grey-200);
    border-radius: 12px;
    background: var(--color-grey-100);
  }

  .tanzkurse-card:hover,
  .tanzkurse-card:focus-visible {
    background: var(--color-grey-200);
  }

  .tanzkurse-card__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .tanzkurse-card__badge {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: var(--color-green-200);
    flex-shrink: 0;
  }

  .tanzkurse-card__title {
    flex: 1;
    font-family: var(--font-family-base);
    font-weight: 500;
    font-size: 1rem;
    color: var(--color-grey-800);
  }

  .tanzkurse-card__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: var(--color-grey-50);
    border: 1px solid var(--color-grey-200);
    color: var(--color-grey-800);
    flex-shrink: 0;
  }

  .tanzkurse-card__desc {
    font-family: var(--font-family-base);
    font-weight: 400;
    font-size: 0.875rem;
    line-height: 1.5em;
    color: var(--color-grey-600);
  }

  .tanzkurse-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tanzkurse-card__tag {
    font-family: var(--font-family-base);
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--color-grey-800);
    background: var(--color-grey-5p);
    border: 1px solid var(--color-grey-10p);
    border-radius: 12px;
    padding: 5px var(--space-2);
  }

  /* Promo panel */
  .tanzkurse-promo {
    position: relative;
    overflow: hidden;
    background: var(--color-grey-900);
    border-radius: 8px;
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .tanzkurse-promo::before {
    content: "";
    position: absolute;
    inset: -40% -10% auto auto;
    width: 60%;
    height: 140%;
    background: var(--color-orange-500);
    opacity: 0.3;
    filter: blur(60px);
    pointer-events: none;
  }

  .tanzkurse-promo__title {
    position: relative;
    font-family: var(--font-family-base);
    font-weight: 700;
    font-size: 2.125rem;
    line-height: 1em;
    color: var(--color-grey-100);
  }

  .tanzkurse-promo__list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-family-base);
    font-weight: 400;
    font-size: 1rem;
    color: var(--color-grey-100);
  }

  .tanzkurse-promo__list li::before {
    content: "✓ ";
  }

  .tanzkurse-promo__button {
    position: relative;
  }

  /* Über uns list */
  .ueberuns-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ueberuns-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-top: 0.8px solid var(--color-grey-300);
  }

  .ueberuns-item__badge {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: var(--color-green-200);
    flex-shrink: 0;
  }

  .ueberuns-item__label {
    flex: 1;
    font-family: var(--font-family-base);
    font-weight: 500;
    font-size: 1rem;
    color: var(--color-grey-900);
  }

  .ueberuns-item__arrow {
    color: var(--color-grey-500);
  }

  .ueberuns-item:hover,
  .ueberuns-item:focus-visible {
    background: var(--color-grey-200);
  }

  /* --- Mobile panel --- */
  .header__mobile-panel {
    margin-top: var(--space-2);
    background: var(--color-grey-50);
    border: 1px solid var(--color-grey-300);
    border-radius: 16px;
    padding: var(--space-6);
  }

  .mobile-panel__links {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-panel__links > li > a,
  .mobile-panel__group summary {
    display: block;
    padding: var(--space-3) 0;
    font-family: var(--font-family-base);
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--color-grey-900);
    cursor: pointer;
  }

  .mobile-panel__group ul {
    list-style: none;
    margin: 0;
    padding-left: var(--space-4);
    display: flex;
    flex-direction: column;
  }

  .mobile-panel__group ul a {
    display: block;
    padding: var(--space-2) 0;
    font-family: var(--font-family-base);
    font-size: 1rem;
    color: var(--color-grey-600);
  }

  .mobile-panel__cta {
    width: 100%;
  }

  /* --- Responsive: collapse to hamburger below ~960px --- */
  @media (max-width: 960px) {
    .header__navbar .header__links,
    .header__cta {
      display: none;
    }

    .header__navbar {
      flex: 1;
      justify-content: space-between;
    }

    .header__burger {
      display: flex;
    }

    .header__dropdown {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .header__dropdown {
      animation: dropdown-in 0.15s ease-out;
    }
  }

  @keyframes dropdown-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
