---
// Shared diagonal arrow glyph (Figma "Icons/arrow-right"), reused in Button,
// Header dropdowns and Footer. Uses currentColor so callers set color via CSS.
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  aria-hidden="true"
>
  <path d="M5.83333 14.1666L14.1667 5.83331" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M5.83333 5.83331H14.1667V14.1666" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
</svg>
