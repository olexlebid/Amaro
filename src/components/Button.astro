---
// Reusable pill button. Mirrors the Figma "Button" component (node 516:416):
// 4 color variants x 3 icon positions.
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import ArrowIcon from "./icons/ArrowIcon.astro";

interface Props {
  variant?: "primary" | "secondary" | "white" | "tertiary";
  icon?: "right" | "left" | "none";
  // Swaps the glyph for a specific use (e.g. InstagramIcon on a social CTA).
  // Renders as a single static icon — the default ArrowIcon's two-copy
  // "fly out" hover slide is a directional cue specific to that glyph, not
  // something to replay for an arbitrary icon without a Figma hover spec.
  iconComponent?: AstroComponentFactory;
  href?: string;
  // Only meaningful together with href, for links that leave the site.
  target?: "_blank";
  rel?: string;
  class?: string;
  // A button that should fill a narrow (mobile) container's width — never a
  // bespoke `width: 100%` per usage, which stretches edge-to-edge with
  // whatever padding that particular parent happens to have. This caps how
  // wide the button can grow and centers it, so every "full width" CTA
  // across the site keeps the same, even left/right gap instead of each
  // component inventing its own.
  fullWidth?: boolean;
}

const {
  variant = "primary",
  icon = "right",
  iconComponent: CustomIcon,
  href,
  target,
  rel,
  class: className,
  fullWidth = false,
} = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  class:list={["button", `button--${variant}`, `button--icon-${icon}`, fullWidth && "button--full-width", className]}
  href={href}
  target={target}
  rel={rel}
>
  {icon === "left" && (
    <span class="button__icon-wrap">
      {CustomIcon ? (
        <CustomIcon class="button__icon" />
      ) : (
        <>
          <ArrowIcon class="button__icon button__icon--out" />
          <ArrowIcon class="button__icon button__icon--in" />
        </>
      )}
    </span>
  )}
  <span class="button__label"><slot /></span>
  {icon === "right" && (
    <span class="button__icon-wrap">
      {CustomIcon ? (
        <CustomIcon class="button__icon" />
      ) : (
        <>
          <ArrowIcon class="button__icon button__icon--out" />
          <ArrowIcon class="button__icon button__icon--in" />
        </>
      )}
    </span>
  )}
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 40px;
    padding-block: var(--space-2);
    padding-inline: var(--space-4);
    border-radius: 32px;
    border: 1px solid transparent;
    font-family: var(--font-family-base);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-align: center;
  }

  .button--icon-right {
    padding-inline: var(--space-4) var(--space-3);
  }

  .button--icon-left {
    padding-inline: var(--space-3) var(--space-4);
  }

  /* Arrow "fly out" hover: two stacked copies of the arrow in a clipped
     20x20 box — the resting copy slides out to the top-right on hover while
     a second copy slides in from the bottom-left to replace it, matching
     the arrow glyph's own NE direction. A common link/button micro-interaction. */
  .button__icon-wrap {
    position: relative;
    width: 20px;
    height: 20px;
    overflow: hidden;
    flex-shrink: 0;
  }

  /* :global() because <ArrowIcon> renders its own root <svg> — it has no
     <style> of its own, so Astro never stamps a scope attribute onto that
     element at all, and a plain (auto-scoped) selector here can't reach it. */
  :global(.button__icon) {
    position: absolute;
    inset: 0;
  }

  :global(.button__icon--out) {
    transform: translate(0, 0);
  }

  :global(.button__icon--in) {
    transform: translate(-100%, 100%);
  }

  /* `min-width: 901px` (the site's shared mobile/desktop breakpoint) is a
     hard backstop on top of the hover/pointer check: some touch browsers
     still report `(hover: hover) and (pointer: fine)` as true, and any
     mobile browser can apply a tapped link's `:hover` state until the next
     tap elsewhere — either way this animation must never fire below desktop. */
  @media (hover: hover) and (pointer: fine) and (min-width: 901px) {
    .button:hover :global(.button__icon--out) {
      transform: translate(100%, -100%);
    }

    .button:hover :global(.button__icon--in) {
      transform: translate(0, 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.button__icon) {
      transition: transform 0.35s ease;
    }
  }

  /* Primary — green pill, used for the main conversion CTA (Probestunde buchen) */
  .button--primary {
    background: var(--color-green-500);
    border-color: var(--color-green-600);
    color: var(--color-grey-50);
    text-shadow: 0 0 4px var(--color-green-600);
  }

  /* Secondary — dark pill, used on light sections as a lower-emphasis action */
  .button--secondary {
    background: var(--color-grey-900);
    border-color: var(--color-grey-950);
    color: var(--color-grey-50);
    text-shadow: 0 0 4px var(--color-grey-950);
  }

  /* White — pill for use on dark/photo backgrounds (e.g. over the hero image) */
  .button--white {
    background: var(--color-grey-50);
    border-color: var(--color-grey-10p);
    color: var(--color-grey-900);
  }

  @media (prefers-reduced-motion: no-preference) {
    .button--primary,
    .button--secondary,
    .button--white {
      transition: background-color 0.2s ease;
    }
  }

  /* Same hover/pointer/width guard as the arrow "fly out" above — desktop-only. */
  @media (hover: hover) and (pointer: fine) and (min-width: 901px) {
    .button--primary:hover {
      background: var(--color-green-600);
    }

    .button--secondary:hover {
      background: var(--color-grey-800);
    }

    .button--white:hover {
      background: var(--color-grey-100);
    }
  }

  /* Tertiary — plain underlined text link, no pill. Figma node 525:2492:
     same 40px height/8px vertical padding as the pill variants, just no
     horizontal padding or fill, plus its own 6px icon gap (vs. 8px). */
  .button--tertiary {
    padding-inline: 0;
    gap: 6px;
    border: none;
    border-bottom: 1.6px solid var(--color-grey-950);
    border-radius: 0;
    color: var(--color-grey-900);
  }

  .button:focus-visible {
    outline: 2px solid var(--color-green-600);
    outline-offset: 2px;
  }

  /* Full-width CTA rule: grows to fill its container but stops at a sane
     reading width instead of stretching edge-to-edge on wider phones/
     tablets, and stays centered so the leftover space (if any) always
     splits evenly left/right. */
  .button--full-width {
    display: flex;
    width: 100%;
    max-width: 400px;
    margin-inline: auto;
  }

  /* Mobile "large" size, Figma node 696:7224 — bigger tap target on touch
     devices. `max-width: 900px` matches the site's shared breakpoint. */
  @media (max-width: 900px) {
    .button {
      height: 48px;
      gap: 6px;
    }

    .button--icon-right {
      padding-inline: var(--space-5) var(--space-4);
    }

    .button--icon-left {
      padding-inline: var(--space-4) var(--space-5);
    }

    .button--icon-none {
      padding-inline: var(--space-5);
    }

    .button--tertiary {
      padding-inline: 4px;
    }
  }
</style>
