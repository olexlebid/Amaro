---
// Full-screen intro: plays the Amaro logo Lottie once, then fades away to
// reveal the page. Shown once per browser session (sessionStorage flag) —
// repeat page loads within the same session skip straight past it so
// navigating the site doesn't replay the intro every time.
//
// The logo shape itself is a *hole*, not a white fill: the canvas is
// inverted every frame (opaque black everywhere except transparent exactly
// where the glyph was drawn), so the already-loaded page underneath shows
// through the letters while the rest of the screen stays covered.
//
// The .lottie file's own timing/scale (see src/assets/lottie/amaro_anim.lottie)
// is left untouched here — only playback (once, not looped) and layout fit are set.
---

<div class="preloader" data-preloader aria-hidden="true">
  <canvas class="preloader__canvas" data-preloader-canvas></canvas>
</div>

<noscript>
  <style>
    /* No JS = no player to reveal the page — never trap no-JS visitors behind it. */
    .preloader {
      display: none !important;
    }
  </style>
</noscript>

<script is:inline>
  // Runs synchronously, right at this point in parsing — before the browser
  // paints anything below it.
  (function () {
    var canvas = document.querySelector("[data-preloader-canvas]");
    var root = document.querySelector("[data-preloader]");

    try {
      if (sessionStorage.getItem("amaro-preloader-seen") === "1") {
        // Intro already played earlier in this session — hide immediately so
        // repeat page loads never flash the overlay.
        if (root) root.hidden = true;
        return;
      }
    } catch (error) {
      // sessionStorage unavailable (e.g. private mode) — fall back to always showing it.
    }

    // Paint an instant solid-black placeholder frame so there's zero gap
    // between first paint and the animated player taking over the canvas
    // (the player resets/clears the canvas once it initializes, moments later).
    if (canvas) {
      var dpr = window.devicePixelRatio || 1;
      canvas.width = Math.ceil(window.innerWidth * dpr);
      canvas.height = Math.ceil(window.innerHeight * dpr);
      var ctx = canvas.getContext("2d");
      if (ctx) {
        ctx.fillStyle = "#000";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      }
    }
  })();
</script>

<script>
  // Plays the intro once, then reveals the page. Waits for the animation to
  // finish AND the window "load" event (so the reveal doesn't race ahead of
  // the page's own images/fonts), capped by a hard timeout so a slow network
  // or a player error can never leave a visitor stuck behind the overlay.
  //
  // NOTE: this script must stay a regular (processed) script, not
  // `define:vars` — define:vars scripts are inlined as-is and skip Astro's
  // bundling, so the npm import below wouldn't resolve.
  //
  // The dotLottie WASM engine is self-hosted (imported from the package
  // instead of left to its default CDN fetch) so no third-party request
  // happens on load — see CLAUDE.md §9 (no external requests without
  // consent) and the "self-host, no CDN" convention already used for fonts.
  import lottieSrc from "../assets/lottie/amaro_anim.lottie?url";
  import wasmUrl from "@lottiefiles/dotlottie-web/dotlottie-player.wasm?url";

  const SESSION_KEY = "amaro-preloader-seen";
  const HARD_TIMEOUT_MS = 8000;
  const FADE_FALLBACK_MS = 600;

  const root = document.querySelector<HTMLElement>("[data-preloader]");
  const canvas = document.querySelector<HTMLCanvasElement>("[data-preloader-canvas]");

  function markIntroSeen() {
    try {
      sessionStorage.setItem(SESSION_KEY, "1");
    } catch (error) {
      // sessionStorage unavailable — worst case the intro plays again next page.
    }
  }

  let revealed = false;
  function reveal() {
    if (revealed || !root) return;
    revealed = true;
    document.documentElement.classList.remove("has-preloader");
    root.classList.add("preloader--hidden");
    root.addEventListener(
      "transitionend",
      () => {
        root.hidden = true;
      },
      { once: true }
    );
    // Fallback in case no transition fires (e.g. prefers-reduced-motion zeroed it out).
    setTimeout(() => {
      root.hidden = true;
    }, FADE_FALLBACK_MS);
  }

  // Cuts a see-through hole in the canvas wherever the just-drawn frame is
  // opaque (the logo glyphs), and leaves solid black everywhere else — so
  // the already-loaded page shows through the letters instead of the
  // glyphs being filled white. Porter-Duff XOR against a full opaque black
  // rect: overlapping (glyph) pixels cancel to transparent, non-overlapping
  // (background) pixels become opaque black.
  function punchHoles(ctx: CanvasRenderingContext2D, target: HTMLCanvasElement) {
    ctx.save();
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.globalCompositeOperation = "xor";
    ctx.fillStyle = "#000";
    ctx.fillRect(0, 0, target.width, target.height);
    ctx.restore();
  }

  if (!root || !canvas || root.hidden) {
    // Already hidden by the sync skip-check above (or markup is missing) — nothing to play.
    reveal();
  } else {
    document.documentElement.classList.add("has-preloader");

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const windowLoaded = new Promise<void>((resolve) => {
      if (document.readyState === "complete") resolve();
      else window.addEventListener("load", () => resolve(), { once: true });
    });

    const animationDone: Promise<void> = reducedMotion
      ? Promise.resolve()
      : import("@lottiefiles/dotlottie-web")
          .then(
            ({ DotLottie }) =>
              new Promise<void>((resolve) => {
                DotLottie.setWasmUrl(wasmUrl);
                const ctx = canvas.getContext("2d");
                const player = new DotLottie({
                  canvas,
                  src: lottieSrc,
                  autoplay: true,
                  loop: false,
                  backgroundColor: "transparent",
                  // "cover" (not "contain"): scale up to fill the whole viewport with
                  // no letterbox bars on wide screens, cropping overflow top/bottom
                  // instead — the logo sits centered with margin to spare either way.
                  layout: { fit: "cover", align: [0.5, 0.5] },
                  renderConfig: { autoResize: true },
                });
                if (ctx) {
                  player.addEventListener("render", () => punchHoles(ctx, canvas));
                }
                player.addEventListener("complete", () => resolve());
                player.addEventListener("loadError", () => resolve());
                player.addEventListener("renderError", () => resolve());
              })
          )
          .catch(() => undefined);

    Promise.all([windowLoaded, animationDone]).then(() => {
      markIntroSeen();
      reveal();
    });

    // Absolute safety net, independent of the above — guarantees the page is
    // never permanently hidden behind the intro.
    setTimeout(() => {
      markIntroSeen();
      reveal();
    }, HARD_TIMEOUT_MS);
  }
</script>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    /* No background here on purpose: the canvas paints its own black fill
       and punches see-through holes for the logo glyphs every frame (see
       punchHoles() above). An opaque div background would sit behind the
       canvas and defeat the see-through effect. */
    opacity: 1;
    transition: opacity 0.5s ease;
  }

  .preloader--hidden {
    opacity: 0;
    pointer-events: none;
  }

  .preloader__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(html.has-preloader) {
    overflow: hidden;
  }
</style>
