---
// Site footer. Figma symbol "Footer" (node 484:1228) — content here is real,
// finished German copy (no placeholders), taken 1:1 from the design.
import { Image } from "astro:assets";
import Button from "./Button.astro";
import adtvLogo from "../assets/partner-logos/adtv_logo.png";
import idoLogo from "../assets/partner-logos/ido_logo.png";
import tafLogo from "../assets/partner-logos/taf_logo.png";
import datLogo from "../assets/partner-logos/dat_logo.png";
import hygieneLogo from "../assets/partner-logos/hygiene_logo.png";

const currentYear = new Date().getFullYear();

const columns = [
  {
    heading: "Schule:",
    links: ["Trainingsplan", "Amaro Team", "Mediathek", "Aktuelles", "Amaro Fashion", "Feiern bei uns", "Kontakt"],
  },
  {
    heading: "Kurse:",
    links: ["Kindertanz & Hip-Hop", "Masterclass", "Hochzeitstanz", "Gesellschaftstanz", "Schülerkurse"],
  },
  {
    heading: "Rechtliches:",
    links: ["Impressum", "Datenschutz", "Cookie-Einstellungen", "Kündigen hier", "Häufige Fragen"],
  },
  {
    heading: "Social:",
    links: ["Instagram", "Spotify", "Facebook", "YouTube"],
  },
];

const partnerLogos = [
  { src: adtvLogo, alt: "ADTV — Allgemeiner Deutscher Tanzlehrerverband" },
  { src: idoLogo, alt: "IDO — International Dance Organization" },
  { src: tafLogo, alt: "TAF Germany", blend: true },
  { src: datLogo, alt: "DAT" },
  { src: hygieneLogo, alt: "Hygiene-zertifiziert" },
];
---

<footer class="footer">
  <div class="footer__watermark" aria-hidden="true">
    <img src="/logo/amaro-logo-dark.svg" alt="" />
  </div>

  <div class="section footer__content">
    <div class="container footer__grid">
      <div class="footer__about">
        <img class="footer__logo" src="/logo/amaro-logo-dark.svg" alt="Tanzschule Amaro" width="103" height="48" />
        <address class="footer__address">
          <p>ADTV-Tanzschule Amaro</p>
          <p>Badenstedter Str. 132,<br />30455 Hannover</p>
          <p><a href="tel:+491772998096">+49 177 299 80 96</a></p>
          <p><a href="mailto:info@tanzschule-amaro.de">info@tanzschule-amaro.de</a></p>
          <p class="footer__hours-label">Bürozeiten:</p>
          <p>Mo–Mi 16:00–20:00,<br />Do–Fr 16:00–19:00</p>
        </address>
      </div>

      {columns.map((column) => (
        <nav class="footer__column" aria-label={column.heading.replace(":", "")}>
          <p class="footer__column-heading">{column.heading}</p>
          <ul>
            {column.links.map((label) => (
              <li><a href="#">{label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="container footer__member-row">
      <div class="footer__member">
        <p class="footer__member-label">Bist du schon dabei?</p>
        <Button variant="tertiary" icon="right" href="#">Mitgliederportal einloggen</Button>
      </div>

      <div class="footer__partners">
        {partnerLogos.map((logo) => (
          <Image
            src={logo.src}
            alt={logo.alt}
            densities={[1, 2]}
            class={logo.blend ? "footer__partner-logo--blend" : undefined}
          />
        ))}
      </div>
    </div>

    <div class="container footer__bottom">
      <p>© {currentYear} Tanzschule Amaro in Hannover-Badenstedt</p>
      <p>Entwickler @olexlebid</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--color-grey-100);
  }

  .footer__watermark {
    position: absolute;
    inset: auto 0 -8% 0;
    pointer-events: none;
    opacity: 0.04;
  }

  .footer__watermark img {
    width: 100%;
    height: auto;
  }

  .footer__content {
    position: relative;
  }

  .footer__grid {
    display: grid;
    /* `1fr` + `max-content` (not 5 even fr tracks, tried and nudged wider
       three times before this) — per Figma (node 579:606): the 4 link
       columns sit close together, each exactly as wide as its own longest
       link, clustered flush against the container's right edge, with all
       the row's leftover space folded into the one gap before them. `1fr`
       on the about column is what creates that: it absorbs 100% of the
       slack (the about column's own content stays put, flush left — only
       its empty track grows), while the link columns can no longer be
       forced wider than their content the way equal `1fr` tracks were. */
    grid-template-columns: 1fr repeat(4, max-content);
    /* 72px between the 4 link columns (was --space-8/32px) — client felt
       them too tightly packed against the right edge; the wider gap here
       also pulls the whole nav cluster's start left (the flexible `1fr`
       about column shrinks to make room), not just spreading columns 2-5
       apart, since it's the same `gap` used for every track boundary. */
    gap: 72px;
    margin-bottom: var(--space-16);
  }

  .footer__logo {
    display: block;
    margin-bottom: var(--space-6);
  }

  .footer__address {
    /* Browsers italicize <address> by default — this isn't in the design */
    font-style: normal;
  }

  .footer__address p {
    font-family: var(--font-family-base);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.5em;
    color: var(--color-grey-900);
    margin-bottom: var(--space-2);
  }

  .footer__address a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer__hours-label {
    color: var(--color-grey-500) !important;
    font-weight: 500 !important;
  }

  .footer__column-heading {
    font-family: var(--font-family-base);
    font-weight: 800;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-grey-400);
    margin-bottom: var(--space-4);
  }

  .footer__column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__column a {
    font-family: var(--font-family-base);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-grey-900);
  }

  .footer__column a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer__member-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-bottom: var(--space-38);
  }

  .footer__member {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .footer__member-label {
    font-family: var(--font-family-base);
    font-weight: 800;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-grey-400);
  }

  .footer__partners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-6);
  }

  /* A shared bounding box per logo, not just a shared height (the old
     `max-height: 60px; width: auto` rule) — the partner marks are wildly
     different shapes (a near-square badge next to a wide flat wordmark), so
     scaling every one to the same height alone still let the wide ones
     (DAT, TAF) read much bigger than the square ones (ADTV, HYGIENE).
     Capping both axes shrinks the wide marks down by width instead, so
     their rendered size actually balances against the square ones — applied
     straight to the `<img>` (not a wrapper box) so each element's own size
     is the scaled logo itself, with no leftover padding inside a fixed box
     inflating the gap between logos beyond the flex `gap` above. */
  .footer__partners :global(img) {
    display: block;
    width: auto;
    height: auto;
    /* Bumped up from 100/52 — client felt the logos read too small next to
       Figma (node 579:606), where they sit noticeably larger/taller. */
    max-width: 130px;
    max-height: 68px;
    object-fit: contain;
  }

  /* TAF logo ships on an opaque white plate — darken-blend it against the
     footer's cream background so the plate disappears and only the mark shows */
  .footer__partners :global(.footer__partner-logo--blend) {
    mix-blend-mode: darken;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-family-base);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-grey-900);
  }

  @media (max-width: 960px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
      /* Desktop's 72px (see .footer__grid above) is tuned for its own
         `1fr`-cluster layout — back to the original 32px for the plain
         2-column mobile stack. */
      gap: var(--space-8);
    }

    .footer__about {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer__logo {
      margin-inline: auto;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer__member-row {
      flex-direction: column;
      align-items: flex-start;
      /* Desktop's --space-8 (32px) row gap is tuned for its own side-by-side
         layout — bumped up for the stacked mobile column, where it's the
         only space between the login link and the logos below it. */
      gap: var(--space-16);
      /* Desktop's --space-38 (152px) is tuned for the row's own wide,
         side-by-side layout — cut down for the stacked mobile column so the
         partner logos don't float so far from the copyright line below. */
      margin-bottom: var(--space-16);
    }

    .footer__partners {
      justify-content: center;
      width: 100%;
    }
  }
</style>
